<!doctype html><html><head><meta charset="utf-8"><title>EasyLabel Icon Library</title><style>body{font-family:Arial;background:#f5f7fb;margin:0;padding:32px;color:#111827}.wrap{max-width:1200px;margin:auto}.card{background:white;border:1px solid #e5e7eb;border-radius:16px;padding:22px;margin:18px 0}.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}input,button{padding:11px 13px;border:1px solid #d1d5db;border-radius:9px}button{cursor:pointer;font-weight:700}.primary{background:#ff3b43;color:#fff;border:0}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:14px;margin-top:18px}.icon{border:1px solid #e5e7eb;border-radius:12px;padding:10px;text-align:center}.icon img{width:100%;height:100px;object-fit:contain;background:#fafafa}.muted{color:#6b7280}</style></head><body><div class="wrap"><h1>Icon Library</h1><p class="muted">Create categories and upload thermal-friendly black & white icons. New categories appear in the app dynamically.</p><% if(message){%><div class="card"><%=message%></div><%}%><div class="card"><h2>New Category</h2><form class="row" method="post" action="/api/icon-library/admin/category"><input name="name" required placeholder="Laundry"><input name="displayOrder" type="number" value="0" placeholder="Order"><button class="primary">Create Category</button></form></div><% categories.forEach(c=>{%><div class="card"><div class="row"><h2 style="margin-right:auto"><%=c.name%></h2><form method="post" action="/api/icon-library/admin/<%=c._id%>/toggle"><button><%=c.active?'Disable':'Enable'%></button></form><form method="post" action="/api/icon-library/admin/<%=c._id%>/delete" onsubmit="return confirm('Delete category?')"><button>Delete</button></form></div><form class="row" method="post" enctype="multipart/form-data" action="/api/icon-library/admin/<%=c._id%>/upload"><input name="name" placeholder="Icon name"><input name="displayOrder" type="number" value="0"><input name="icon" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml,.svg" required><button class="primary">Upload Icon</button></form><div class="grid"><% (c.icons||[]).forEach(i=>{%><div class="icon"><img src="/icon-assets/<%=c._id%>/<%=i._id%>"><b><%=i.name%></b><form method="post" action="/api/icon-library/admin/<%=c._id%>/icon/<%=i._id%>/delete"><button>Delete</button></form></div><%})%></div></div><%})%></div></body></html>
