function bindBulkImageDeleteControls(){
  const selectAllProduct=document.getElementById('selectAllProductImages');
  const deleteProduct=document.getElementById('deleteSelectedProductImages');
  const selectAllAPlus=document.getElementById('selectAllAPlusImages');
  const deleteAPlus=document.getElementById('deleteSelectedAPlusImages');

  if(selectAllProduct && !selectAllProduct.dataset.bound){
    selectAllProduct.dataset.bound='1';
    selectAllProduct.addEventListener('click',e=>{
      e.preventDefault();
      e.stopPropagation();
      toggleSelectAllProductImages();
    });
  }

  if(deleteProduct && !deleteProduct.dataset.bound){
    deleteProduct.dataset.bound='1';
    deleteProduct.addEventListener('click',async e=>{
      e.preventDefault();
      e.stopPropagation();
      await deleteSelectedProductImages();
    });
  }

  if(selectAllAPlus && !selectAllAPlus.dataset.bound){
    selectAllAPlus.dataset.bound='1';
    selectAllAPlus.addEventListener('click',e=>{
      e.preventDefault();
      e.stopPropagation();
      toggleSelectAllAPlusImages();
    });
  }

  if(deleteAPlus && !deleteAPlus.dataset.bound){
    deleteAPlus.dataset.bound='1';
    deleteAPlus.addEventListener('click',async e=>{
      e.preventDefault();
      e.stopPropagation();
      await deleteSelectedAPlusImages();
    });
  }
}

if(document.readyState==='loading'){
  document.addEventListener('DOMContentLoaded',bindBulkImageDeleteControls);
}else{
  bindBulkImageDeleteControls();
}

async function saveProduct(e){
  e.preventDefault();

  const id = form.id.value;
  const fd = new FormData(form);

  fd.set('active', form.active.checked ? 'true' : 'false');
  fd.set('featured', form.featured.checked ? 'true' : 'false');
  fd.delete('id');

  const submitButton = form.querySelector('button[type="submit"]');
  const originalText = submitButton ? submitButton.textContent : '';

  try {
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Uploading...';
    }

    const result = await call('/api/products' + (id ? '/' + id : ''), {
      method: id ? 'PUT' : 'POST',
      body: fd
    });

    alert(id ? 'Product updated successfully' : 'Product added successfully');
    location.reload();
  } catch (err) {
    console.error('Product upload failed:', err);
    alert(err.message || 'Unable to upload product. Please check file size/type and try again.');
  } finally {
    if (submitButton) {
      submitButton.disabled = false;
      submitButton.textContent = originalText || 'Save Product';
    }
  }
}
