<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>EasyLabel Shop Manager</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f5f7fb;color:#111827;font-family:Inter,Arial,sans-serif}.shell{display:grid;grid-template-columns:260px 1fr;min-height:100vh}.side{background:#263c52;color:#fff;padding:28px 22px;position:sticky;top:0;height:100vh}.brand{font-size:28px;font-weight:800;margin-bottom:28px}.side a{display:block;color:#dbe7f3;text-decoration:none;padding:12px 14px;border-radius:10px;margin:4px 0}.side a.active{background:#20c3a5;color:#fff;font-weight:700}.main{padding:34px;max-width:1500px}.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.head h1{margin:0;font-size:32px}.muted{color:#6b7280}.card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:20px;box-shadow:0 8px 24px rgba(15,23,42,.04);margin-bottom:18px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}label{display:block;font-size:12px;font-weight:700;color:#374151;margin-bottom:5px}input,textarea,select{width:100%;padding:11px 12px;border:1px solid #dbe1e8;border-radius:10px;font:inherit;outline:none}input:focus,textarea:focus,select:focus{border-color:#ff2d2d;box-shadow:0 0 0 3px rgba(255,45,45,.08)}button{border:0;border-radius:10px;padding:11px 16px;font-weight:700;cursor:pointer}.primary{background:#ff2d2d;color:#fff}.secondary{background:#f1f5f9;color:#334155}.danger{background:#fff1f2;color:#e11d48}.toolbar{display:flex;gap:8px;align-items:center}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:980px}th,td{padding:12px 10px;border-bottom:1px solid #eef1f5;text-align:left;vertical-align:middle}th{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#64748b}.thumb{width:56px;height:56px;border-radius:10px;object-fit:contain;background:#f8fafc;border:1px solid #eef1f5}.pill{display:inline-block;padding:4px 8px;border-radius:99px;font-size:11px;font-weight:700;background:#f1f5f9}.on{background:#dcfce7;color:#15803d}.off{background:#fee2e2;color:#b91c1c}.price{font-weight:800}.old{text-decoration:line-through;color:#94a3b8;font-size:12px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.stat{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:16px}.stat strong{display:block;font-size:24px;margin-top:4px}.modal{position:fixed;inset:0;background:rgba(15,23,42,.5);display:none;align-items:center;justify-content:center;padding:20px;z-index:50}.modal.show{display:flex}.modalbox{background:#fff;border-radius:18px;width:min(900px,100%);max-height:92vh;overflow:auto;padding:22px}.modalhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.x{background:#f1f5f9;padding:8px 12px}.search{max-width:360px}@media(max-width:900px){.shell{grid-template-columns:1fr}.side{position:static;height:auto}.main{padding:18px}.grid,.grid2,.stats{grid-template-columns:1fr}}
</style></head><body><div class="shell"><aside class="side"><div class="brand">EasyLabel</div><a href="/premium-management">← Subscription Management</a><a class="active" href="/shop-management">🛍 Shop Manager</a><a href="/orderspage">Orders</a><a href="/coupons">Coupons</a></aside><main class="main">
<div class="head"><div><h1>Shop Manager</h1><div class="muted">Everything shown in the Android Shop is controlled here.</div></div><button class="primary" onclick="openProduct()">+ Add Product</button></div>
<% const active=products.filter(p=>p.active!==false).length, featured=products.filter(p=>p.featured).length, low=products.filter(p=>p.stock>=0&&p.stock<=5).length; %>
<div class="stats"><div class="stat"><span class="muted">Products</span><strong><%=products.length%></strong></div><div class="stat"><span class="muted">Active</span><strong><%=active%></strong></div><div class="stat"><span class="muted">Featured</span><strong><%=featured%></strong></div><div class="stat"><span class="muted">Low Stock</span><strong><%=low%></strong></div></div>
<div class="card"><h2 style="margin-top:0">Storefront Settings</h2><div class="grid"><div><label>Hero Badge</label><input id="heroBadge" value="<%=settings.heroBadge||'EasyLabel Shop'%>"></div><div><label>Hero Title</label><input id="heroTitle" value="<%=settings.heroTitle||'Everything your business needs'%>"></div><div><label>Hero Image URL</label><input id="heroImageUrl" value="<%=settings.heroImageUrl||''%>"></div></div><div style="margin-top:12px"><label>Hero Subtitle</label><textarea id="heroSubtitle" rows="2"><%=settings.heroSubtitle||''%></textarea></div><div class="grid2" style="margin-top:12px"><div><label>Trust / Shipping Text</label><input id="shippingText" value="<%=settings.shippingText||''%>"></div><div><label>Support Text</label><input id="supportText" value="<%=settings.supportText||''%>"></div></div><div style="margin-top:12px"><label><input id="shopEnabled" type="checkbox" style="width:auto" <%=settings.enabled===false?'':'checked'%>> Shop enabled in app</label></div><button class="primary" style="margin-top:12px" onclick="saveSettings()">Save Storefront</button></div>
<div class="card"><div class="head" style="margin-bottom:12px"><div><h2 style="margin:0">Products</h2><div class="muted">Add, edit, hide, feature, price and stock products without changing the APK.</div></div><input class="search" id="search" placeholder="Search product, SKU, category..." oninput="filterRows()"></div><div class="tablewrap"><table><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Flags</th><th>Order</th><th>Action</th></tr></thead><tbody id="rows"><% products.forEach(p=>{ %><tr data-search="<%=(p.name+' '+(p.sku||'')+' '+(p.category?.name||'')).toLowerCase()%>"><td><div style="display:flex;gap:10px;align-items:center"><img class="thumb" src="<%=p.images?.[0]||''%>"><div><strong><%=p.name%></strong><div class="muted" style="font-size:11px"><%=p.sku||'No SKU'%></div></div></div></td><td><span class="pill"><%=p.category?.name||'Other'%></span></td><td><div class="price">₹<%=p.price%></div><% if(p.mrp>p.price){ %><div class="old">₹<%=p.mrp%></div><% } %></td><td><%=p.stock<0?'Unlimited':p.stock%></td><td><span class="pill <%=p.active!==false?'on':'off'%>"><%=p.active!==false?'ACTIVE':'HIDDEN'%></span> <% if(p.featured){ %><span class="pill">FEATURED</span><% } %><% if(p.badge){ %><div class="muted" style="font-size:11px;margin-top:4px"><%=p.badge%></div><% } %></td><td><%=p.sortOrder||0%></td><td><div class="toolbar"><button class="secondary" onclick='openProduct(<%-JSON.stringify(p)%>)'>Edit</button><button class="danger" onclick="removeProduct('<%=p._id%>')">Delete</button></div></td></tr><% }) %></tbody></table></div></div>
</main></div>
<div class="modal" id="modal"><div class="modalbox"><div class="modalhead"><div><h2 id="modalTitle" style="margin:0">Add Product</h2><div class="muted">Product changes go live in the Android Shop after save.</div></div><button class="x" onclick="closeProduct()">✕</button></div><form id="form" onsubmit="saveProduct(event)"><input type="hidden" name="id"><div class="grid"><div><label>Product Name *</label><input name="name" required></div><div><label>SKU / Model</label><input name="sku"></div><div><label>Category *</label><input name="categoryName" list="cats" required><datalist id="cats"><% [...new Set(products.map(p=>p.category?.name).filter(Boolean))].forEach(c=>{ %><option value="<%=c%>"><% }) %></datalist></div><div><label>Selling Price ₹ *</label><input name="price" type="number" min="0" required></div><div><label>MRP ₹</label><input name="mrp" type="number" min="0"></div><div><label>Stock</label><input name="stock" type="number" value="-1"><small class="muted">-1 = unlimited / not tracked</small></div><div><label>Badge</label><input name="badge" placeholder="BEST SELLER / NEW / 20% OFF"></div><div><label>Sort Order</label><input name="sortOrder" type="number" value="0"></div><div><label>Category Image URL</label><input name="categoryImageUrl"></div></div><div style="margin-top:12px"><label>Product Image URLs * (one per line)</label><textarea name="images" rows="4" required></textarea></div><div style="margin-top:12px"><label>Description</label><textarea name="description" rows="5"></textarea></div><div class="toolbar" style="margin-top:14px"><label><input name="active" type="checkbox" style="width:auto" checked> Active</label><label><input name="featured" type="checkbox" style="width:auto"> Featured</label></div><div class="toolbar" style="margin-top:16px"><button class="primary">Save Product</button><button type="button" class="secondary" onclick="closeProduct()">Cancel</button></div></form></div></div>
<script>
const modal=document.getElementById('modal'),form=document.getElementById('form');
function openProduct(p){form.reset();form.active.checked=true;form.stock.value=-1;form.sortOrder.value=0;form.id.value='';document.getElementById('modalTitle').textContent='Add Product';if(p){document.getElementById('modalTitle').textContent='Edit Product';form.id.value=p._id||'';form.name.value=p.name||'';form.sku.value=p.sku||'';form.categoryName.value=p.category?.name||'';form.categoryImageUrl.value=p.category?.imageUrl||'';form.price.value=p.price||0;form.mrp.value=p.mrp||0;form.stock.value=p.stock??-1;form.badge.value=p.badge||'';form.sortOrder.value=p.sortOrder||0;form.images.value=(p.images||[]).join('\n');form.description.value=p.description||'';form.active.checked=p.active!==false;form.featured.checked=!!p.featured}modal.classList.add('show')}
function closeProduct(){modal.classList.remove('show')}
async function call(url,opt={}){const r=await fetch(url,opt);const d=await r.json();if(!r.ok||d.success===false)throw new Error(d.message||'Request failed');return d}
async function saveProduct(e){e.preventDefault();const fd=new FormData(form),id=fd.get('id');const data=Object.fromEntries(fd.entries());data.active=form.active.checked;data.featured=form.featured.checked;data.images=String(data.images||'').split(/\r?\n/).map(x=>x.trim()).filter(Boolean);delete data.id;try{await call(id?'/api/products/'+id:'/api/products',{method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});location.reload()}catch(err){alert(err.message)}}
async function removeProduct(id){if(!confirm('Delete this product?'))return;try{await call('/api/products/'+id,{method:'DELETE'});location.reload()}catch(err){alert(err.message)}}
async function saveSettings(){const data={enabled:document.getElementById('shopEnabled').checked,heroBadge:heroBadge.value,heroTitle:heroTitle.value,heroSubtitle:heroSubtitle.value,heroImageUrl:heroImageUrl.value,shippingText:shippingText.value,supportText:supportText.value};try{await call('/api/products/settings',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});alert('Storefront updated successfully')}catch(err){alert(err.message)}}
function filterRows(){const q=document.getElementById('search').value.toLowerCase().trim();document.querySelectorAll('#rows tr').forEach(r=>r.style.display=r.dataset.search.includes(q)?'':'none')}
</script></body></html>