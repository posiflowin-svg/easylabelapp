<!doctype html>
<html>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>EasyLabel Shop Manager</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f5f7fb;color:#111827;font-family:Inter,Arial,sans-serif}
.shell{display:grid;grid-template-columns:260px 1fr;min-height:100vh}.side{background:#263c52;color:#fff;padding:28px 22px;position:sticky;top:0;height:100vh}
.brand{font-size:28px;font-weight:800;margin-bottom:28px}.side a{display:block;color:#dbe7f3;text-decoration:none;padding:12px 14px;border-radius:10px;margin:4px 0}.side a.active{background:#20c3a5;color:#fff;font-weight:700}
.main{padding:32px;max-width:1500px}.head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.head h1,.head h2{margin:0}.muted{color:#6b7280}
.card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:20px;box-shadow:0 8px 24px rgba(15,23,42,.04);margin-bottom:18px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
label{display:block;font-size:12px;font-weight:700;color:#374151;margin-bottom:5px}input,textarea,select{width:100%;padding:11px 12px;border:1px solid #dbe1e8;border-radius:10px;font:inherit;outline:none}
input:focus,textarea:focus,select:focus{border-color:#ff2d2d;box-shadow:0 0 0 3px rgba(255,45,45,.08)}
button{border:0;border-radius:10px;padding:10px 14px;font-weight:700;cursor:pointer}.primary{background:#ff2d2d;color:#fff}.secondary{background:#f1f5f9;color:#334155}.danger{background:#fff1f2;color:#e11d48}
.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:900px}th,td{padding:12px 10px;border-bottom:1px solid #eef1f5;text-align:left;vertical-align:middle}
th{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#64748b}.thumb{width:58px;height:58px;border-radius:10px;object-fit:contain;background:#f8fafc;border:1px solid #eef1f5}
.pill{display:inline-block;padding:4px 8px;border-radius:99px;font-size:11px;font-weight:700;background:#f1f5f9}.on{background:#dcfce7;color:#15803d}.off{background:#fee2e2;color:#b91c1c}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.stat{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:16px}.stat strong{display:block;font-size:24px;margin-top:4px}
.modal{position:fixed;inset:0;background:rgba(15,23,42,.5);display:none;align-items:center;justify-content:center;padding:20px;z-index:50}.modal.show{display:flex}.modalbox{background:#fff;border-radius:18px;width:min(920px,100%);max-height:92vh;overflow:auto;padding:22px}
.preview{width:120px;height:68px;border-radius:10px;object-fit:contain;background:#f8fafc;border:1px solid #e5e7eb}.section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.notice{background:#fff7ed;color:#9a3412;border:1px solid #fed7aa;border-radius:10px;padding:10px 12px;font-size:12px}

.image-manager{margin-top:12px}
.image-grid{display:flex;gap:10px;flex-wrap:wrap;min-height:20px}
.image-tile{width:132px;border:1px solid #e5e7eb;border-radius:12px;background:#fff;padding:7px;cursor:grab;position:relative}
.image-tile.dragging{opacity:.45}
.image-tile.main{border:2px solid #ff2d2d;box-shadow:0 0 0 3px rgba(255,45,45,.08)}
.image-tile img{width:116px;height:92px;object-fit:contain;border-radius:8px;background:#f8fafc}
.image-tile .handle{text-align:center;color:#94a3b8;font-size:12px;margin-top:3px}

.image-select{position:absolute;top:7px;right:7px;width:22px;height:22px;accent-color:#ff2d2d;cursor:pointer;z-index:3}
.image-tile.selected{border:2px solid #2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.10)}
.bulk-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:8px 0 10px}
.bulk-toolbar .count{font-size:12px;color:#64748b;font-weight:700}
.bulk-toolbar button:disabled{opacity:.45;cursor:not-allowed}

.image-actions{display:flex;gap:5px;margin-top:6px}
.image-actions button{font-size:10px;padding:6px 7px;flex:1}
.main-label{position:absolute;top:5px;left:5px;background:#ff2d2d;color:#fff;border-radius:99px;padding:3px 7px;font-size:9px;font-weight:800}

@media(max-width:900px){.shell{grid-template-columns:1fr}.side{position:static;height:auto}.main{padding:18px}.grid,.grid2,.stats{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="shell">
<aside class="side">
<div class="brand">EasyLabel</div>
<a href="/premium-management">← Subscription Management</a>
<a class="active" href="/shop-management">🛍 Shop Manager</a>
<a href="/orderspage">Orders</a><a href="/coupons">Coupons</a>
</aside>
<main class="main">
<div class="head"><div><h1>Shop Manager</h1><div class="muted">Control products, categories, category order and Shop slider without releasing a new APK.</div></div><button class="primary" onclick="openProduct()">+ Add Product</button></div>
<% const active=products.filter(p=>p.active!==false).length, featured=products.filter(p=>p.featured).length, low=products.filter(p=>p.stock>=0&&p.stock<=5).length; %>
<div class="stats"><div class="stat"><span class="muted">Products</span><strong><%=products.length%></strong></div><div class="stat"><span class="muted">Active</span><strong><%=active%></strong></div><div class="stat"><span class="muted">Best Sellers</span><strong><%=featured%></strong></div><div class="stat"><span class="muted">Categories</span><strong><%=categories.length%></strong></div></div>

<div class="card">
<div class="section-title"><div><h2 style="margin:0">Shop Slider</h2><div class="muted">Upload promotional banners. Sequence is controlled by Order.</div></div></div>
<form id="bannerForm" enctype="multipart/form-data" onsubmit="saveBanner(event)">
<input type="hidden" name="id">
<div class="grid">
<div><label>Badge</label><input name="badge" value="EasyLabel Shop"></div>
<div><label>Title</label><input name="title" placeholder="Premium Printing Made Easy"></div>
<div><label>Order</label><input name="sortOrder" type="number" value="0"></div>
</div>
<div class="grid2" style="margin-top:12px">
<div><label>Subtitle</label><input name="subtitle" placeholder="Best Quality • Best Price • Fast Delivery"></div>
<div><label>Optional Click URL</label><input name="clickUrl" placeholder="https://..."></div>
</div>
<div class="grid2" style="margin-top:12px">
<div><label>Upload Banner Image</label><input name="image" type="file" accept="image/png,image/jpeg,image/webp"></div>
<div><label>Or Image URL</label><input name="imageUrl" placeholder="https://..."></div>
</div>
<div class="toolbar" style="margin-top:12px"><label style="margin:0"><input name="active" type="checkbox" style="width:auto" checked> Active</label><button class="primary">Save Slider</button><button type="button" class="secondary" onclick="resetBanner()">Clear</button></div>
</form>
<div class="tablewrap" style="margin-top:14px"><table><thead><tr><th>Preview</th><th>Content</th><th>Order</th><th>Status</th><th>Action</th></tr></thead><tbody>
<% if(!banners.length){ %><tr><td colspan="5" class="muted">No Shop slider banners yet.</td></tr><% } %>
<% banners.forEach(b=>{ %><tr><td><img class="preview" src="<%=b.imageUrl||''%>"></td><td><strong><%=b.title||'Image banner'%></strong><div class="muted"><%=b.subtitle||''%></div></td><td><%=b.sortOrder||0%></td><td><span class="pill <%=b.active?'on':'off'%>"><%=b.active?'ACTIVE':'HIDDEN'%></span></td><td><div class="toolbar"><button class="secondary" onclick='editBanner(<%-JSON.stringify(b)%>)'>Edit</button><button class="danger" onclick="deleteBanner('<%=b._id%>')">Delete</button></div></td></tr><% }) %>
</tbody></table></div>
</div>

<div class="card">
<div class="section-title"><div><h2 style="margin:0">Product Categories</h2><div class="muted">Upload category image and set the exact sequence shown in the Android Shop.</div></div></div>
<form id="categoryForm" enctype="multipart/form-data" onsubmit="saveCategory(event)">
<input type="hidden" name="id">
<div class="grid">
<div><label>Category Name *</label><input name="name" required placeholder="Label Printers"></div>
<div><label>Sequence / Order</label><input name="sortOrder" type="number" value="0"></div>
<div><label>Upload Category Image</label><input name="image" type="file" accept="image/png,image/jpeg,image/webp"></div>
</div>
<div class="grid2" style="margin-top:12px"><div><label>Or Image URL</label><input name="imageUrl" placeholder="https://..."></div><div class="toolbar" style="align-self:end"><label style="margin:0"><input name="active" type="checkbox" style="width:auto" checked> Active</label><button class="primary">Save Category</button><button type="button" class="secondary" onclick="resetCategory()">Clear</button></div></div>
</form>
<div class="tablewrap" style="margin-top:14px"><table><thead><tr><th>Image</th><th>Category</th><th>Sequence</th><th>Status</th><th>Action</th></tr></thead><tbody>
<% if(!categories.length){ %><tr><td colspan="5" class="muted">No managed categories yet. Existing product categories still work as fallback.</td></tr><% } %>
<% categories.forEach(c=>{ %><tr><td><img class="thumb" src="<%=c.imageUrl||''%>"></td><td><strong><%=c.name%></strong></td><td><%=c.sortOrder||0%></td><td><span class="pill <%=c.active?'on':'off'%>"><%=c.active?'ACTIVE':'HIDDEN'%></span></td><td><div class="toolbar"><button class="secondary" onclick='editCategory(<%-JSON.stringify(c)%>)'>Edit</button><button class="danger" onclick="deleteCategory('<%=c._id%>')">Delete</button></div></td></tr><% }) %>
</tbody></table></div>
</div>

<div class="card">
<h2 style="margin-top:0">Storefront Settings</h2>
<div class="grid"><div><label>Fallback Hero Badge</label><input id="heroBadge" value="<%=settings.heroBadge||'EasyLabel Shop'%>"></div><div><label>Fallback Hero Title</label><input id="heroTitle" value="<%=settings.heroTitle||'Premium Printing Made Easy'%>"></div><div><label>Slider Speed (ms)</label><input id="sliderIntervalMs" type="number" min="2000" max="15000" value="<%=settings.sliderIntervalMs||4500%>"></div></div>
<div style="margin-top:12px"><label>Fallback Hero Subtitle</label><textarea id="heroSubtitle" rows="2"><%=settings.heroSubtitle||''%></textarea></div>
<div class="grid2" style="margin-top:12px"><div><label>Trust / Shipping Text</label><input id="shippingText" value="<%=settings.shippingText||''%>"></div><div><label>Support Text</label><input id="supportText" value="<%=settings.supportText||''%>"></div></div>
<div style="margin-top:12px"><label><input id="shopEnabled" type="checkbox" style="width:auto" <%=settings.enabled===false?'':'checked'%>> Shop enabled in app</label></div>
<button class="primary" style="margin-top:12px" onclick="saveSettings()">Save Storefront</button>
</div>

<div class="card">
<div class="head" style="margin-bottom:12px"><div><h2>Products</h2><div class="muted">Featured products become Best Sellers in the app.</div></div><input style="max-width:360px" id="search" placeholder="Search product, SKU, category..." oninput="filterRows()"></div>
<div class="tablewrap"><table><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Flags</th><th>Order</th><th>Action</th></tr></thead><tbody id="rows">
<% products.forEach(p=>{ %><tr data-search="<%=(p.name+' '+(p.sku||'')+' '+(p.category?.name||'')).toLowerCase()%>"><td><div style="display:flex;gap:10px;align-items:center"><img class="thumb" src="<%=p.images?.[0]||''%>"><div><strong><%=p.name%></strong><div class="muted" style="font-size:11px"><%=p.sku||'No SKU'%></div></div></div></td><td><span class="pill"><%=p.category?.name||'Other'%></span></td><td><strong>₹<%=p.price%></strong><% if(p.mrp>p.price){ %><div class="muted" style="text-decoration:line-through">₹<%=p.mrp%></div><% } %></td><td><%=p.stock<0?'Unlimited':p.stock%></td><td><span class="pill <%=p.active!==false?'on':'off'%>"><%=p.active!==false?'ACTIVE':'HIDDEN'%></span> <% if(p.featured){ %><span class="pill">BEST SELLER</span><% } %></td><td><%=p.sortOrder||0%></td><td><div class="toolbar"><button class="secondary" onclick="openProductById('<%=p._id%>')">Edit</button><button class="danger" onclick="removeProduct('<%=p._id%>')">Delete</button></div></td></tr><% }) %>
</tbody></table></div></div>
</main></div>

<div class="modal" id="modal"><div class="modalbox"><div class="head"><div><h2 id="modalTitle">Add Product</h2><div class="muted">Changes go live in Android after save.</div></div><button class="secondary" onclick="closeProduct()">✕</button></div>
<form id="form" enctype="multipart/form-data" onsubmit="saveProduct(event)"><input type="hidden" name="id"><div class="grid">
<div><label>Product Name *</label><input name="name" required></div><div><label>SKU / Model</label><input name="sku"></div>
<div><label>Category *</label><input name="categoryName" list="cats" required><datalist id="cats"><% categories.forEach(c=>{ %><option value="<%=c.name%>"><% }) %></datalist></div>
<div><label>Selling Price ₹ *</label><input name="price" type="number" min="0" required></div><div><label>MRP ₹</label><input name="mrp" type="number" min="0"></div><div><label>Stock</label><input name="stock" type="number" value="-1"></div>
<div><label>Badge</label><input name="badge" placeholder="BESTSELLER / NEW"></div><div><label>Product Sort Order</label><input name="sortOrder" type="number" value="0"></div>
</div>
<div class="grid2" style="margin-top:12px">
<div><label>Upload Product Images</label><input name="productImageFiles" type="file" accept="image/png,image/jpeg,image/webp" multiple><div class="muted" style="font-size:11px;margin-top:5px">Up to 8 product images.</div></div>
<div><label>Or Product Image URLs (one per line)</label><textarea name="images" rows="4" placeholder="https://.../main.jpg\nhttps://.../second.jpg"></textarea></div>
</div>
<div class="image-manager" id="uploadedImageManager" style="display:none">
  <label>Uploaded Product Images</label>
  <div class="muted" style="font-size:11px;margin-bottom:6px">Drag images to change sequence. The first image is the Main Image shown in the Shop.</div>
  <div class="bulk-toolbar">
    <button type="button" class="secondary" id="selectAllProductImages">Select All</button>
    <button type="button" class="danger" id="deleteSelectedProductImages" disabled>Delete Selected</button>
    <span class="count" id="productImageSelectionCount">0 selected</span>
  </div>
  <div class="image-grid" id="uploadedImageGrid"></div>
</div>
<div style="margin-top:12px"><label>Key Bullet Points (one point per line)</label><textarea name="bulletPoints" rows="5" placeholder="USB + Bluetooth connectivity\nFast thermal printing\nCompact design"></textarea></div>
<div style="margin-top:12px"><label>Product Description</label><textarea name="description" rows="5" placeholder="Detailed product information shown on the product page"></textarea></div>
<div class="card" style="margin-top:14px;background:#f8fafc;box-shadow:none">
<h3 style="margin-top:0">A+ Product Content</h3>
<div class="grid2">
<div><label>Upload A+ Images</label><input name="aPlusImageFiles" type="file" accept="image/png,image/jpeg,image/webp" multiple><div class="muted" style="font-size:11px;margin-top:5px">Up to 10 A+ images.</div></div>
<div><label>Or A+ Image URLs (one per line)</label><textarea name="aPlusImages" rows="5" placeholder="https://.../feature1.jpg\nhttps://.../feature2.jpg"></textarea></div>
</div>
<div class="image-manager" id="uploadedAPlusImageManager" style="display:none">
  <label>Uploaded A+ Images</label>
  <div class="muted" style="font-size:11px;margin-bottom:6px">Drag images to change the A+ sequence. The first image is shown first on the Product Detail page. Use Set Main to move any A+ image to the first position.</div>
  <div class="bulk-toolbar">
    <button type="button" class="secondary" id="selectAllAPlusImages">Select All</button>
    <button type="button" class="danger" id="deleteSelectedAPlusImages" disabled>Delete Selected</button>
    <span class="count" id="aPlusImageSelectionCount">0 selected</span>
  </div>
  <div class="image-grid" id="uploadedAPlusImageGrid"></div>
</div>
<div style="margin-top:12px"><label>A+ Text Blocks (one per line)</label><textarea name="aPlusTexts" rows="5" placeholder="High-speed printing for busy counters\nBluetooth printing from Android devices"></textarea></div>
</div>
<div class="card" style="margin-top:14px;background:#f8fafc;box-shadow:none">
<h3 style="margin-top:0">Product Video</h3>
<div class="grid2">
<div><label>Upload Product Video</label><input name="productVideoFile" type="file" accept="video/mp4,video/webm"><div class="muted" style="font-size:11px;margin-top:5px">MP4 or WebM, maximum 12 MB.</div></div>
<div><label>Or Product Video URL</label><input name="productVideoUrl" placeholder="https://.../product-video.mp4"></div>
</div>
</div>
<div class="toolbar" style="margin-top:14px"><label><input name="active" type="checkbox" style="width:auto" checked> Active</label><label><input name="featured" type="checkbox" style="width:auto"> Best Seller</label></div>
<div class="toolbar" style="margin-top:16px"><button class="primary">Save Product</button><button type="button" class="secondary" onclick="closeProduct()">Cancel</button></div></form>
</div></div>

<script>
const modal=document.getElementById('modal'),form=document.getElementById('form'),categoryForm=document.getElementById('categoryForm'),bannerForm=document.getElementById('bannerForm');
async function call(url,opt={}){
  const r=await fetch(url,opt);
  const contentType=r.headers.get('content-type')||'';
  let d={};
  let raw='';

  if(contentType.includes('application/json')){
    try{ d=await r.json(); }catch(_){}
  }else{
    try{ raw=await r.text(); }catch(_){}
  }

  if(!r.ok || d.success===false){
    const cleanRaw=(raw||'').replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim();
    throw new Error(d.message || cleanRaw.slice(0,220) || `Request failed (${r.status})`);
  }
  return d;
}
async function openProductById(id){
  if(!id) return;
  try{
    const result=await call('/api/products/'+encodeURIComponent(id));
    if(!result || !result.data) throw new Error('Product data not found');
    openProduct(result.data);
  }catch(err){
    console.error('Unable to open product editor:',err);
    alert(err.message||'Unable to open product for editing');
  }
}

function openProduct(p){form.reset();form.active.checked=true;form.stock.value=-1;form.sortOrder.value=0;form.id.value='';document.getElementById('modalTitle').textContent='Add Product';renderUploadedImages(null);renderUploadedAPlusImages(null);if(p){document.getElementById('modalTitle').textContent='Edit Product';form.id.value=p._id||'';form.name.value=p.name||'';form.sku.value=p.sku||'';form.categoryName.value=p.category?.name||'';form.price.value=p.price||0;form.mrp.value=p.mrp||0;form.stock.value=p.stock??-1;form.badge.value=p.badge||'';form.sortOrder.value=p.sortOrder||0;form.images.value=(p.externalImages||p.images||[]).join('\n');form.bulletPoints.value=(p.bulletPoints||[]).join('\n');form.description.value=p.description||'';form.aPlusImages.value=(p.externalAPlusImages||p.aPlusImages||[]).join('\n');form.aPlusTexts.value=(p.aPlusTexts||[]).join('\n');form.productVideoUrl.value=p.productVideoUrl||'';form.active.checked=p.active!==false;form.featured.checked=!!p.featured;renderUploadedImages(p);renderUploadedAPlusImages(p)}modal.classList.add('show');bindBulkImageDeleteControls();}
function closeProduct(){modal.classList.remove('show')}


async function deleteUploadedMedia(productId, kind, mediaIds){
  const ids=[...new Set((mediaIds||[]).map(id=>String(id||'').trim()).filter(Boolean))];
  if(!productId || !ids.length) throw new Error('No image selected.');

  return await call(`/api/products/${productId}/media/delete-selection`,{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({kind,mediaIds:ids})
  });
}

let draggedMediaId=null;

function renderUploadedImages(product){
  const manager=document.getElementById('uploadedImageManager');
  const grid=document.getElementById('uploadedImageGrid');
  if(!manager || !grid) return;
  grid.innerHTML='';

  const media=(product && Array.isArray(product.uploadedMedia))
    ? [...product.uploadedMedia].sort((a,b)=>(a.sortOrder||0)-(b.sortOrder||0))
    : [];

  if(!product || !product._id || media.length===0){
    manager.style.display='none';
    return;
  }

  manager.style.display='block';

  media.forEach((item,index)=>{
    const tile=document.createElement('div');
    tile.className='image-tile'+(index===0?' main':'');
    tile.draggable=true;
    tile.dataset.mediaId=item._id;

    tile.innerHTML=`
      ${index===0?'<span class="main-label">MAIN</span>':''}
      <input type="checkbox" class="image-select media-select" aria-label="Select product image">
      <img src="${item.url}" alt="Product image">
      <div class="handle">↕ Drag to reorder</div>
      <div class="image-actions">
        <button type="button" class="secondary set-main">Set Main</button>
        <button type="button" class="danger delete-image">Delete</button>
      </div>
    `;

    const selectBox=tile.querySelector('.media-select');
    if(selectBox){
      selectBox.addEventListener('click',e=>e.stopPropagation());
      selectBox.addEventListener('change',()=>{
        tile.classList.toggle('selected',selectBox.checked);
        if(typeof updateProductImageSelectionUi==='function') updateProductImageSelectionUi();
      });
    }

    tile.addEventListener('dragstart',()=>{
      draggedMediaId=item._id;
      tile.classList.add('dragging');
    });

    tile.addEventListener('dragend',()=>{
      draggedMediaId=null;
      tile.classList.remove('dragging');
    });

    tile.addEventListener('dragover',e=>e.preventDefault());

    tile.addEventListener('drop',async e=>{
      e.preventDefault();
      if(!draggedMediaId || draggedMediaId===item._id) return;

      const cards=[...grid.querySelectorAll('.image-tile')];
      const dragged=cards.find(card=>card.dataset.mediaId===draggedMediaId);
      const target=cards.find(card=>card.dataset.mediaId===item._id);
      if(!dragged || !target) return;

      const targetRect=target.getBoundingClientRect();
      const after=e.clientX > targetRect.left + targetRect.width/2;
      grid.insertBefore(dragged, after ? target.nextSibling : target);

      await saveImageSequence(product._id);
    });

    tile.querySelector('.set-main')?.addEventListener('click',async()=>{
      grid.insertBefore(tile,grid.firstChild);
      await saveImageSequence(product._id);
    });

    tile.querySelector('.delete-image')?.addEventListener('click',async()=>{
      if(!confirm('Delete this uploaded product image?')) return;
      const button=tile.querySelector('.delete-image');
      if(button){button.disabled=true;button.textContent='Deleting...';}
      try{
        const result=await deleteUploadedMedia(product._id,'product_image',[item._id]);
        renderUploadedImages(result.data);
      }catch(err){
        alert(err.message||'Unable to delete product image');
        if(button){button.disabled=false;button.textContent='Delete';}
      }
    });

    grid.appendChild(tile);
  });
  updateProductImageSelectionUi();
}

async function saveImageSequence(productId){
  const grid=document.getElementById('uploadedImageGrid');
  const orderedIds=[...grid.querySelectorAll('.image-tile')].map(tile=>tile.dataset.mediaId);

  try{
    const result=await call(`/api/products/${productId}/reorder-images`,{
      method:'PUT',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({orderedIds})
    });

    renderUploadedImages(result.data);
  }catch(err){
    alert(err.message||'Unable to update image sequence');
  }
}


let draggedAPlusMediaId=null;

function renderUploadedAPlusImages(product){
  const manager=document.getElementById('uploadedAPlusImageManager');
  const grid=document.getElementById('uploadedAPlusImageGrid');
  if(!manager || !grid) return;
  grid.innerHTML='';

  const media=(product && Array.isArray(product.uploadedAPlusMedia))
    ? [...product.uploadedAPlusMedia].sort((a,b)=>(a.sortOrder||0)-(b.sortOrder||0))
    : [];

  if(!product || !product._id || media.length===0){
    manager.style.display='none';
    return;
  }

  manager.style.display='block';

  media.forEach((item,index)=>{
    const tile=document.createElement('div');
    tile.className='image-tile'+(index===0?' main':'');
    tile.draggable=true;
    tile.dataset.mediaId=item._id;

    tile.innerHTML=`
      ${index===0?'<span class="main-label">FIRST</span>':''}
      <input type="checkbox" class="image-select aplus-media-select" aria-label="Select A+ image">
      <img src="${item.url}" alt="A+ image">
      <div class="handle">↕ Drag to reorder</div>
      <div class="image-actions">
        <button type="button" class="secondary set-main">Set Main</button>
        <button type="button" class="danger delete-image">Delete</button>
      </div>
    `;

    const selectBox=tile.querySelector('.aplus-media-select');
    if(selectBox){
      selectBox.addEventListener('click',e=>e.stopPropagation());
      selectBox.addEventListener('change',()=>{
        tile.classList.toggle('selected',selectBox.checked);
        if(typeof updateAPlusImageSelectionUi==='function') updateAPlusImageSelectionUi();
      });
    }

    tile.addEventListener('dragstart',()=>{
      draggedAPlusMediaId=item._id;
      tile.classList.add('dragging');
    });
    tile.addEventListener('dragend',()=>{
      draggedAPlusMediaId=null;
      tile.classList.remove('dragging');
    });
    tile.addEventListener('dragover',e=>e.preventDefault());
    tile.addEventListener('drop',async e=>{
      e.preventDefault();
      if(!draggedAPlusMediaId || draggedAPlusMediaId===item._id) return;
      const cards=[...grid.querySelectorAll('.image-tile')];
      const dragged=cards.find(card=>card.dataset.mediaId===draggedAPlusMediaId);
      const target=cards.find(card=>card.dataset.mediaId===item._id);
      if(!dragged || !target) return;
      const rect=target.getBoundingClientRect();
      const after=e.clientX > rect.left + rect.width/2;
      grid.insertBefore(dragged,after?target.nextSibling:target);
      await saveAPlusImageSequence(product._id);
    });

    tile.querySelector('.set-main')?.addEventListener('click',async()=>{
      grid.insertBefore(tile,grid.firstChild);
      await saveAPlusImageSequence(product._id);
    });

    tile.querySelector('.delete-image')?.addEventListener('click',async()=>{
      if(!confirm('Delete this uploaded A+ image?')) return;
      const button=tile.querySelector('.delete-image');
      if(button){button.disabled=true;button.textContent='Deleting...';}
      try{
        const result=await deleteUploadedMedia(product._id,'aplus_image',[item._id]);
        renderUploadedAPlusImages(result.data);
      }catch(err){
        alert(err.message||'Unable to delete A+ image');
        if(button){button.disabled=false;button.textContent='Delete';}
      }
    });

    grid.appendChild(tile);
  });
  if(typeof updateAPlusImageSelectionUi==='function') updateAPlusImageSelectionUi();
}

async function saveAPlusImageSequence(productId){
  const grid=document.getElementById('uploadedAPlusImageGrid');
  const orderedIds=[...grid.querySelectorAll('.image-tile')].map(tile=>tile.dataset.mediaId);
  try{
    const result=await call(`/api/products/${productId}/reorder-aplus-images`,{
      method:'PUT',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({orderedIds})
    });
    renderUploadedAPlusImages(result.data);
  }catch(err){
    alert(err.message||'Unable to update A+ image sequence');
  }
}


function selectedProductImageIds(){
  return [...document.querySelectorAll('#uploadedImageGrid .image-tile')]
    .filter(tile=>tile.querySelector('.media-select')?.checked)
    .map(tile=>tile.dataset.mediaId)
    .filter(Boolean);
}

function updateProductImageSelectionUi(){
  const grid=document.getElementById('uploadedImageGrid');
  const total=grid.querySelectorAll('.image-tile').length;
  const selected=selectedProductImageIds().length;
  const count=document.getElementById('productImageSelectionCount');
  const deleteButton=document.getElementById('deleteSelectedProductImages');
  const selectAll=document.getElementById('selectAllProductImages');
  if(count) count.textContent=`${selected} selected`;
  if(deleteButton) deleteButton.disabled=selected===0;
  if(selectAll) selectAll.textContent=total>0 && selected===total ? 'Clear Selection' : 'Select All';
}

function toggleSelectAllProductImages(){
  const boxes=[...document.querySelectorAll('#uploadedImageGrid .media-select')];
  if(!boxes.length){
    alert('No uploaded product images available.');
    return;
  }
  const shouldSelect=boxes.some(box=>!box.checked);
  boxes.forEach(box=>{
    box.checked=shouldSelect;
    box.closest('.image-tile')?.classList.toggle('selected',shouldSelect);
  });
  updateProductImageSelectionUi();
}

async function deleteSelectedProductImages(){
  const productId=form?.id?.value || '';
  const mediaIds=selectedProductImageIds();
  if(!productId){
    alert('Product ID not found. Close Edit Product and open it again.');
    return;
  }
  if(!mediaIds.length){
    alert('Please select at least one product image.');
    return;
  }
  if(!confirm(`Delete ${mediaIds.length} selected product image(s)?`)) return;

  const button=document.getElementById('deleteSelectedProductImages');
  if(button) button.disabled=true;

  try{
    const result=await deleteUploadedMedia(productId,'product_image',mediaIds);
    renderUploadedImages(result.data);
  }catch(err){
    alert(err.message||'Unable to delete selected product images');
    updateProductImageSelectionUi();
    const button=document.getElementById('deleteSelectedProductImages');
    if(button) button.disabled=selectedProductImageIds().length===0;
  }
}

