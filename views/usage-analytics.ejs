<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Customer Usage Analytics | EasyLabel</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f6f7fb;color:#17191d;font-family:Inter,Arial,sans-serif}.layout{display:flex;min-height:100vh}.side{width:250px;background:#2d4358;color:white;padding:28px 22px;position:fixed;inset:0 auto 0 0}.brand{font-size:28px;font-weight:800;margin:4px 10px 42px}.side a{display:block;color:#dfe8f1;text-decoration:none;padding:13px 14px;margin:7px 0;border-radius:10px;font-size:16px}.side a:hover,.side a.active{background:#3a5268;color:#fff}.main{margin-left:250px;width:calc(100% - 250px);padding:34px 38px 60px}.head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}.head h1{margin:0;font-size:30px}.head p{margin:7px 0 0;color:#747984}.filters{display:grid;grid-template-columns:1.2fr .8fr .8fr .8fr auto;gap:12px;background:#fff;border:1px solid #e7e9ee;border-radius:16px;padding:16px;margin-bottom:20px}.field label{display:block;font-size:12px;font-weight:700;color:#747984;margin:0 0 7px}.field input,.field select{width:100%;height:44px;border:1px solid #dde1e7;border-radius:10px;padding:0 12px;font-size:14px;background:white}.apply{align-self:end;height:44px;border:0;border-radius:10px;padding:0 22px;background:#ff3038;color:white;font-weight:700;cursor:pointer}.cards{display:grid;grid-template-columns:repeat(6,1fr);gap:13px;margin-bottom:20px}.card{background:#fff;border:1px solid #e7e9ee;border-radius:15px;padding:17px;min-width:0}.card .k{font-size:12px;color:#7c818a;font-weight:700}.card .v{font-size:25px;font-weight:800;margin-top:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;margin-bottom:18px}.panel{background:#fff;border:1px solid #e7e9ee;border-radius:16px;padding:19px}.panel h2{font-size:18px;margin:0 0 15px}.bars{display:flex;align-items:flex-end;height:210px;gap:7px;border-bottom:1px solid #eceef2;padding:14px 4px 0;overflow:hidden}.barWrap{height:100%;flex:1;min-width:12px;display:flex;align-items:flex-end;position:relative}.bar{width:100%;background:#ff3a42;border-radius:5px 5px 0 0;min-height:2px}.sizeRow{display:grid;grid-template-columns:100px 1fr 70px;align-items:center;gap:10px;margin:12px 0;font-size:13px}.track{height:8px;background:#f0f1f4;border-radius:10px;overflow:hidden}.fill{height:100%;background:#ff3a42;border-radius:10px}.tablePanel{background:#fff;border:1px solid #e7e9ee;border-radius:16px;overflow:hidden;margin-top:18px}.tableHead{padding:19px 20px;font-size:18px;font-weight:800;border-bottom:1px solid #eceef2}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;min-width:880px}th,td{text-align:left;padding:13px 16px;border-bottom:1px solid #eff1f4;font-size:13px}th{color:#727780;background:#fafbfc;font-size:12px}.badge{padding:5px 8px;border-radius:8px;font-size:11px;font-weight:800}.label{background:#fff0f1;color:#e3262e}.bill{background:#eef8f2;color:#159653}.empty{text-align:center;color:#989da5;padding:28px}.money{font-variant-numeric:tabular-nums}@media(max-width:1200px){.cards{grid-template-columns:repeat(3,1fr)}.filters{grid-template-columns:repeat(2,1fr)}.apply{width:100%}}@media(max-width:800px){.side{display:none}.main{margin:0;width:100%;padding:20px}.grid{grid-template-columns:1fr}.cards{grid-template-columns:repeat(2,1fr)}.filters{grid-template-columns:1fr}}
</style></head><body><div class="layout"><aside class="side"><div class="brand">EasyLabel</div><a href="/">Dashboard</a><a href="/sells_users">Users Wallet</a><a href="/orderspage">Orders</a><a href="/usage-analytics" class="active">Usage Analytics</a><a href="/premium-management">Subscription Management</a></aside><main class="main">
<div class="head"><div><h1>Customer Usage Analytics</h1><p>Label printing and Quick Billing activity synced from customer devices.</p></div></div>
<div class="filters"><div class="field"><label>Customer name / mobile / email</label><input id="customer" placeholder="Search customer"></div><div class="field"><label>From</label><input id="from" type="date"></div><div class="field"><label>To</label><input id="to" type="date"></div><div class="field"><label>Activity</label><select id="type"><option value="">All activity</option><option>LABEL_PRINT</option><option>BILL_PRINT</option></select></div><button class="apply" onclick="loadData()">Apply Filter</button></div>
<div class="cards"><div class="card"><div class="k">LABELS PRINTED</div><div class="v" id="labels">0</div></div><div class="card"><div class="k">LABEL PRINT JOBS</div><div class="v" id="labelJobs">0</div></div><div class="card"><div class="k">BILLS PRINTED</div><div class="v" id="bills">0</div></div><div class="card"><div class="k">TOTAL SALES</div><div class="v money" id="sales">₹0</div></div><div class="card"><div class="k">ITEMS SOLD</div><div class="v" id="items">0</div></div><div class="card"><div class="k">ACTIVE CUSTOMERS</div><div class="v" id="users">0</div></div></div>
<div class="grid"><section class="panel"><h2>Activity Overview</h2><div class="bars" id="bars"></div><div style="font-size:11px;color:#858a93;margin-top:8px">Daily label volume (hover a bar for date and count)</div></section><section class="panel"><h2>Labels by Size</h2><div id="sizes"></div></section></div>
<div class="tablePanel"><div class="tableHead">Customer Summary</div><div class="scroll"><table><thead><tr><th>Customer</th><th>Mobile</th><th>Labels</th><th>Bills</th><th>Items</th><th>Sales</th><th>Last Activity</th></tr></thead><tbody id="customers"></tbody></table></div></div>
<div class="tablePanel"><div class="tableHead">Recent Activity</div><div class="scroll"><table><thead><tr><th>Date & Time</th><th>Customer</th><th>Mobile</th><th>Activity</th><th>Details</th><th>Printer</th></tr></thead><tbody id="recent"></tbody></table></div></div>
</main></div><script>
const money=n=>'₹'+Number(n||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});const dt=v=>v?new Date(v).toLocaleString('en-IN'):'';
async function loadData(){const q=new URLSearchParams();['customer','from','to','type'].forEach(id=>{const v=document.getElementById(id).value;if(v)q.set(id,v)});const r=await fetch('/api/usage/summary?'+q);const j=await r.json();if(!j.success)return;const t=j.totals||{};labels.textContent=(t.labelsPrinted||0).toLocaleString('en-IN');labelJobs.textContent=(t.labelPrintJobs||0).toLocaleString('en-IN');bills.textContent=(t.billsPrinted||0).toLocaleString('en-IN');sales.textContent=money(t.totalSales);items.textContent=(t.totalItems||0).toLocaleString('en-IN');users.textContent=(t.activeCustomers||0).toLocaleString('en-IN');
const max=Math.max(1,...(j.daily||[]).map(x=>x.labels||0));bars.innerHTML=(j.daily||[]).length?(j.daily||[]).map(x=>`<div class="barWrap" title="${x._id.day}: ${x.labels||0} labels"><div class="bar" style="height:${Math.max(2,(x.labels||0)/max*100)}%"></div></div>`).join(''):'<div class="empty">No activity in this period</div>';
const maxS=Math.max(1,...(j.sizeWise||[]).map(x=>x.copies||0));sizes.innerHTML=(j.sizeWise||[]).length?(j.sizeWise||[]).map(x=>`<div class="sizeRow"><b>${x._id.w||0}×${x._id.h||0} mm</b><div class="track"><div class="fill" style="width:${(x.copies||0)/maxS*100}%"></div></div><div>${(x.copies||0).toLocaleString('en-IN')}</div></div>`).join(''):'<div class="empty">No label-size data</div>';
customers.innerHTML=(j.customers||[]).length?(j.customers||[]).map(x=>`<tr><td><b>${x.name||'Unknown'}</b><div style="color:#9297a0">${x.email||''}</div></td><td>${x._id.mobile||'—'}</td><td>${x.labels||0}</td><td>${x.bills||0}</td><td>${x.items||0}</td><td>${money(x.sales)}</td><td>${dt(x.lastActivity)}</td></tr>`).join(''):'<tr><td colspan="7" class="empty">No customers found</td></tr>';
recent.innerHTML=(j.recent||[]).length?(j.recent||[]).map(x=>`<tr><td>${dt(x.occurredAt)}</td><td>${x.customerName||'Unknown'}</td><td>${x.customerMobile||'—'}</td><td><span class="badge ${x.eventType==='LABEL_PRINT'?'label':'bill'}">${x.eventType==='LABEL_PRINT'?'LABEL PRINT':'QUICK BILLING'}</span></td><td>${x.eventType==='LABEL_PRINT'?`${x.labelWidthMm||0}×${x.labelHeightMm||0} mm · ${x.copies||0} copies`:`${x.billNo||''} · ${x.itemCount||0} items · ${money(x.billAmount)}`}</td><td>${x.printerModel||'—'}</td></tr>`).join(''):'<tr><td colspan="6" class="empty">No activity found</td></tr>';}
(function(){const d=new Date(),to=d.toISOString().slice(0,10);d.setDate(d.getDate()-29);document.getElementById('to').value=to;document.getElementById('from').value=d.toISOString().slice(0,10);loadData()})();
</script></body></html>
