<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Usage Analytics | EasyLabel</title>
<style>
:root{--nav:#2d4358;--nav2:#405a72;--ink:#172033;--muted:#7b8492;--line:#e6eaf0;--bg:#f6f7fa;--card:#fff;--red:#ff343b;--green:#168a58;--blue:#2d67b3}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,Arial,sans-serif}.layout{display:flex;min-height:100vh}
.side{width:252px;background:var(--nav);color:#fff;padding:30px 20px;position:fixed;inset:0 auto 0 0;overflow-y:auto}.brand{font-size:29px;font-weight:800;margin:2px 12px 48px}.side a{display:block;color:#e2e9f0;text-decoration:none;padding:14px 16px;margin:7px 0;border-radius:11px;font-size:16px}.side a.active,.side a:hover{background:var(--nav2);color:#fff}
.main{margin-left:252px;width:calc(100% - 252px);padding:32px 38px 60px;max-width:1680px}.head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:18px}.head h1{font-size:30px;margin:0 0 7px}.sub{color:var(--muted);font-size:14px}
.filters,.panel,.metric{background:#fff;border:1px solid var(--line);box-shadow:0 2px 8px rgba(22,32,51,.035)}.filters{display:grid;grid-template-columns:1.4fr .8fr .8fr .8fr auto;gap:12px;padding:16px;border-radius:16px;margin-bottom:16px}.field label{display:block;font-size:11px;letter-spacing:.04em;text-transform:uppercase;font-weight:800;color:#858c99;margin-bottom:7px}.field input,.field select{height:43px;width:100%;border:1px solid #dfe3e9;border-radius:9px;padding:0 12px;font-size:14px;background:#fff}.apply{height:43px;align-self:end;border:0;border-radius:9px;background:var(--red);color:#fff;padding:0 22px;font-weight:800;cursor:pointer}
.rangeBar{display:flex;gap:8px;align-items:center;margin:-4px 0 14px;flex-wrap:wrap}
.rangeLabel{font-size:11px;font-weight:800;color:#818997;text-transform:uppercase;letter-spacing:.04em;margin-right:2px}
.rangeBtn{height:34px;border:1px solid #dfe3e9;background:#fff;color:#596273;border-radius:8px;padding:0 12px;font-size:12px;font-weight:800;cursor:pointer}
.rangeBtn.active{background:#172033;border-color:#172033;color:#fff}
.searchHint{font-size:11px;color:#8c94a1;margin-top:6px}
.searchState{display:none;font-size:11px;color:#2d67b3;font-weight:700;margin-top:6px}.searchState.show{display:block}
.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:13px;margin-bottom:16px}.metric{border-radius:14px;padding:16px 18px}.metric .k{font-size:11px;font-weight:800;color:#7c8492;letter-spacing:.04em}.metric .v{font-size:26px;font-weight:800;margin-top:8px}.metric .hint{font-size:11px;color:#9aa2ad;margin-top:5px}
.analytics{display:grid;grid-template-columns:1.15fr .85fr;gap:16px;margin-bottom:17px}.panel{border-radius:15px;padding:19px}.panelTitle{font-size:17px;font-weight:800;margin-bottom:15px}.trend{height:155px;display:flex;align-items:flex-end;gap:6px;border-bottom:1px solid #edf0f3}.barWrap{height:100%;flex:1;display:flex;align-items:flex-end;min-width:5px}.bar{width:100%;background:#ff454c;border-radius:4px 4px 0 0;min-height:2px}.hint{font-size:11px;color:#9aa2ad}.sizeRow{display:grid;grid-template-columns:90px 1fr 58px;gap:10px;align-items:center;margin:10px 0;font-size:12px}.track{height:7px;background:#f0f2f5;border-radius:9px;overflow:hidden}.fill{height:100%;background:#ff454c;border-radius:9px}
.tabsWrap{background:#fff;border:1px solid var(--line);border-radius:15px;overflow:hidden;box-shadow:0 2px 8px rgba(22,32,51,.035)}.tabs{display:flex;gap:5px;padding:10px 12px;border-bottom:1px solid var(--line);background:#fbfcfd}.tab{border:0;background:transparent;color:#6f7886;padding:11px 17px;border-radius:9px;font-size:14px;font-weight:800;cursor:pointer}.tab.active{background:#172033;color:#fff}.tabCount{font-size:11px;margin-left:6px;opacity:.72}
.tabBody{display:none}.tabBody.active{display:block}.tableHead{display:flex;justify-content:space-between;align-items:center;padding:18px 20px 12px}.tableHead h2{font-size:18px;margin:0}.tableHead .note{font-size:12px;color:#9198a4}.scroll{overflow:auto}table{border-collapse:collapse;width:100%;min-width:980px}th,td{padding:13px 17px;text-align:left;border-bottom:1px solid #f0f2f5;font-size:13px}th{background:#fafbfc;color:#727b89;font-size:10px;text-transform:uppercase;letter-spacing:.055em;position:sticky;top:0}.nameLink{border:0;background:none;padding:0;font-weight:800;color:#172033;cursor:pointer;text-align:left}.mobileLink,.purchaseLink{border:0;background:none;padding:0;color:#2d67b3;cursor:pointer;font-weight:700}.purchaseLink{text-decoration:underline;text-decoration-color:#cbd7e7;text-underline-offset:3px}.purchaseMeta{font-size:10px;color:#9299a5;margin-top:4px}.noPurchase{color:#9aa2ad;font-weight:700}.crmWarn{margin:0 20px 12px;padding:9px 12px;border:1px solid #f1dfb8;background:#fffaf0;border-radius:9px;color:#86621d;font-size:11px;display:none}.email{font-size:11px;color:#9299a5;margin-top:3px}.num{font-variant-numeric:tabular-nums;font-weight:700}.badge{display:inline-block;padding:5px 8px;border-radius:7px;font-size:10px;font-weight:800}.badge.label{background:#fff0f1;color:#e52f37}.badge.bill{background:#edf9f3;color:#168a58}.modelBadge{display:inline-flex;background:#eef2f7;border-radius:8px;padding:6px 10px;font-weight:800;color:#32465c}.empty{text-align:center;padding:36px;color:#989faa}
.pager{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-top:1px solid var(--line);background:#fff}.pageBtns{display:flex;gap:7px}.pageBtn{height:34px;min-width:34px;border:1px solid #dfe3e9;background:#fff;border-radius:8px;padding:0 10px;font-weight:700;cursor:pointer}.pageBtn:disabled{opacity:.4;cursor:not-allowed}.pageInfo{font-size:12px;color:#858d99}
.modalBack{display:none;position:fixed;inset:0;background:rgba(17,24,39,.45);z-index:50;align-items:center;justify-content:center;padding:20px}.modal{background:#fff;border-radius:18px;width:min(920px,96vw);max-height:88vh;overflow:hidden;box-shadow:0 22px 70px rgba(0,0,0,.2)}.modalHead{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.modalHead h3{margin:0;font-size:19px}.close{border:0;background:#f3f4f6;width:34px;height:34px;border-radius:9px;font-size:20px;cursor:pointer}.modalBody{padding:18px 20px;overflow:auto;max-height:74vh}.miniMetrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:15px}.mini{border:1px solid var(--line);border-radius:11px;padding:11px}.mini b{display:block;font-size:18px;margin-top:4px}.mini span{font-size:10px;color:#858d99;text-transform:uppercase;font-weight:800}
@media(max-width:1200px){.metrics{grid-template-columns:repeat(3,1fr)}.filters{grid-template-columns:repeat(2,1fr)}.analytics{grid-template-columns:1fr}}@media(max-width:800px){.side{display:none}.main{margin:0;width:100%;padding:18px}.metrics{grid-template-columns:repeat(2,1fr)}.filters{grid-template-columns:1fr}.tabs{overflow:auto}.miniMetrics{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<div class="layout">
<aside class="side">
  <div class="brand">EasyLabel</div>
  <a href="/">Dashboard</a>
  <a href="/sells_users">Users Wallet</a>
  <a href="/orderspage">Orders</a>
  <a class="active" href="/usage-analytics">Usage Analytics</a>
  <a href="/premium-management">Subscription Management</a>
</aside>
<main class="main">
  <div class="head"><div><h1>Usage Analytics</h1><div class="sub">Lifetime activity remains stored. Use the date filters to analyse any period without losing historical data.</div></div></div>

  <div class="filters">
    <div class="field"><label>Customer</label><input id="customer" autocomplete="off" placeholder="Search entire database by name, mobile or email"><div class="searchHint">Searches all recorded customers, not only the current page.</div><div class="searchState" id="searchState">Searching entire database…</div></div>
    <div class="field"><label>From</label><input id="from" type="date"></div>
    <div class="field"><label>To</label><input id="to" type="date"></div>
    <div class="field"><label>Activity</label><select id="type"><option value="">All activity</option><option value="LABEL_PRINT">Label Printing</option><option value="BILL_PRINT">Quick Billing</option><option value="INVENTORY_SNAPSHOT">Inventory</option></select></div>
    <button class="apply" onclick="applyFilter()">Apply Filter</button>
  </div>

  <div class="rangeBar">
    <span class="rangeLabel">Date Range</span>
    <button class="rangeBtn active" id="rangeToday" onclick="setDateRange('today',this)">Today</button>
    <button class="rangeBtn" id="rangeThisMonth" onclick="setDateRange('thisMonth',this)">This Month</button>
    <button class="rangeBtn" id="rangeLastMonth" onclick="setDateRange('lastMonth',this)">Last Month</button>
    <button class="rangeBtn" id="rangeAllTime" onclick="setDateRange('allTime',this)">All Time</button>
    <button class="rangeBtn" id="rangeCustom" onclick="setDateRange('custom',this)">Custom Date</button>
  </div>

  <div class="metrics">
    <div class="metric"><div class="k">LABELS PRINTED</div><div class="v" id="labels">0</div><div class="hint">Total copies in selected period</div></div>
    <div class="metric"><div class="k">PRINT COMMANDS</div><div class="v" id="labelJobs">0</div><div class="hint">Label print jobs</div></div>
    <div class="metric"><div class="k">BILLS PRINTED</div><div class="v" id="bills">0</div><div class="hint">Quick Billing receipts</div></div>
    <div class="metric"><div class="k">TOTAL SALES</div><div class="v" id="sales">₹0</div><div class="hint">From printed bills</div></div>
    <div class="metric"><div class="k">ACTIVE CUSTOMERS</div><div class="v" id="users">0</div><div class="hint">In selected period</div></div>
  </div>

  <div class="analytics">
    <section class="panel"><div class="panelTitle">Label Printing Trend</div><div class="trend" id="bars"></div><div class="hint" style="margin-top:8px">Daily label copies</div></section>
    <section class="panel"><div class="panelTitle">Labels by Size</div><div id="sizes"></div></section>
  </div>

  <section class="panel" style="padding:20px;margin-bottom:18px" id="customerTargeting">
    <div class="panelTitle">Customer Targeting by Label Size <span style="font-size:11px;color:#64748b;font-weight:normal">Verified-admin audience preview</span></div>
    <p class="sub" style="margin:8px 0 18px">Find unique customers by actual label copies printed. Campaign delivery and discounts require identity-verified integration; this view does not send messages.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;align-items:end">
      <div class="field"><label>Period</label><select id="targetPeriod"><option value="month">This month</option><option value="last">Last month</option><option value="90days">Last 90 days</option><option value="lifetime">Lifetime</option><option value="custom">Custom</option></select></div>
      <div class="field"><label>Label size</label><select id="targetSize"><option value="50x25">50×25 mm</option><option value="50x12">50×12 mm</option><option value="50x30">50×30 mm</option><option value="50x50">50×50 mm</option><option value="38x25">38×25 mm</option><option value="38x38">38×38 mm</option><option value="48x100">48×100 mm</option><option value="100x150">100×150 mm</option></select></div>
      <div class="field"><label>Min copies</label><input id="targetMinimum" type="number" min="1" value="1"></div>
      <div class="field"><label>From (custom)</label><input id="targetFrom" type="date"></div>
      <div class="field"><label>To (custom)</label><input id="targetTo" type="date"></div>
      <button class="apply" onclick="loadTargetAudience(1)">Find Customers</button>
    </div>
    <p id="targetStatus" class="sub" style="margin:16px 0">Select filters to preview matching customers.</p>
    <div class="scroll"><table style="min-width:650px"><thead><tr><th><input type="checkbox" id="targetSelectPage" onchange="selectTargetPage(this.checked)" aria-label="Select current page"></th><th>Customer</th><th>Mobile</th><th>Labels printed</th><th>Print jobs</th><th>Last activity</th></tr></thead><tbody id="targetRows"><tr><td colspan="6">Apply filters to load customers</td></tr></tbody></table></div>
    <div class="pager"><span id="targetSelected">0 selected on this page</span><div class="pageBtns"><button class="pageBtn" onclick="loadTargetAudience(Math.max(1,targetPage-1))">Previous</button><button class="pageBtn" onclick="loadTargetAudience(targetPage+1)">Next</button></div></div>
  </section>
<section id="targetCampaignPanel" style="margin:18px auto;padding:22px;max-width:1320px;background:#fff;border:1px solid #e0e5ef;border-radius:14px">
 <h3 style="margin:0 0 7px">Targeted Campaign Builder <small style="font-size:12px;color:#667085">Draft workflow · no messages sent</small></h3>
 <p style="color:#667085">Choose customers from the filtered table, an entire 5,000-user batch, or all matching customers. Save a campaign draft for review.</p>
 <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:end">
 <label>Audience<br><select id="tcMode"><option value="manual">Manually selected (across pages)</option><option value="batch">Batch of up to 5,000</option><option value="all">All matching customers</option></select></label>
 <label>Batch number<br><input id="tcBatch" type="number" min="1" value="1" style="width:90px"></label>
 <label>Channel<br><select id="tcChannel"><option value="push">Push Notification</option><option value="banner">In-app Banner</option><option value="both">Push + Banner</option></select></label>
 <label>Campaign title<br><input id="tcTitle" maxlength="150" placeholder="Special offer for 50×25" style="width:230px"></label>
 <div style="min-width:260px;flex:1;max-width:420px;position:relative">
  <label for="tcProductSearch" style="display:block;margin-bottom:4px">Shop product</label>
  <input id="tcProductSearch" type="search" autocomplete="off" placeholder="Search product name, SKU or category" style="width:100%;box-sizing:border-box" aria-controls="tcProductResults" aria-expanded="false">
  <input type="hidden" id="tcProduct">
  <div id="tcProductResults" role="listbox" style="display:none;position:absolute;top:100%;left:0;right:0;z-index:15;background:white;border:1px solid #cbd5e1;border-radius:9px;box-shadow:0 12px 26px #14233d22;max-height:250px;overflow:auto"></div>
  <div id="tcProductPicked" style="font-size:12px;color:#64748b;margin-top:4px">Choose an active Shop product.</div>
  <label for="tcVariant" style="display:block;margin-top:8px">Variant (optional)</label>
  <select id="tcVariant" disabled style="width:100%"><option value="">Default product</option></select>
</div>
 <label>Discount<br><select id="tcDiscountType"><option value="percent">Percentage (%)</option><option value="fixed">Fixed (₹)</option></select></label>
 <label>Value<br><input id="tcDiscount" type="number" min="0" step="0.01" value="10" style="width:90px"></label>
 <button id="tcSave" type="button" style="background:#ef3340;color:white;border:0;border-radius:8px;padding:11px 18px;cursor:pointer">Save campaign draft</button>
 </div><p id="tcStatus" style="color:#58677e" role="status">No draft created. Selected customers are retained across pages in this browser tab.</p>
 <div id="tcHistory" style="font-size:13px;color:#58677e"></div><div id="tcReview" role="status" style="margin-top:12px;padding:12px;border-radius:9px;background:#f1f5f9;color:#24334c;display:none"></div>
</section>
  <!-- Admin verification is required only for customer-level targeting data. -->
  <div id="targetAuthOverlay" role="presentation" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.58);z-index:9999;align-items:center;justify-content:center;padding:16px">
    <div role="dialog" aria-modal="true" aria-labelledby="targetAuthTitle" style="background:#fff;border-radius:16px;max-width:420px;width:100%;box-shadow:0 20px 70px rgba(0,0,0,.22);padding:26px">
      <h2 id="targetAuthTitle" style="margin:0 0 8px;font-size:21px;color:#14233d">Verify administrator access</h2>
      <p style="margin:0 0 18px;color:#64748b;line-height:1.5">Customer names and mobile numbers are protected. Enter the administrator password configured in Render to view the matching audience. This is required once per session.</p>
      <form id="targetAuthForm">
        <label for="targetAdminPassword" style="display:block;font-size:13px;font-weight:700;margin-bottom:7px">Admin password</label>
        <input id="targetAdminPassword" type="password" autocomplete="current-password" required style="box-sizing:border-box;width:100%;border:1px solid #cbd5e1;border-radius:9px;padding:12px;font-size:15px">
        <p id="targetAuthError" role="alert" style="display:none;color:#b91c1c;font-size:13px;margin:10px 0 0"></p>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px">
          <button type="button" id="targetAuthCancel" style="border:1px solid #cbd5e1;border-radius:9px;background:#fff;padding:10px 18px;cursor:pointer">Cancel</button>
          <button type="submit" id="targetAuthSubmit" style="border:0;border-radius:9px;background:#ef3340;color:#fff;font-weight:700;padding:10px 18px;cursor:pointer">Verify &amp; continue</button>
        </div>
      </form>
    </div>
  </div>
  <section class="tabsWrap">
    <div class="tabs">
      <button class="tab active" data-tab="customerTab" onclick="switchTab('customerTab',this)">Customer Summary <span class="tabCount" id="customerCount"></span></button>
      <button class="tab" data-tab="recentTab" onclick="switchTab('recentTab',this)">Recent Activity</button>
      <button class="tab" data-tab="modelTab" onclick="switchTab('modelTab',this)">Printer Models</button>
    </div>

    <div class="tabBody active" id="customerTab">
      <div class="tableHead"><div><h2>Customer Summary</h2><div class="note">Label usage + exact-mobile purchase history from Posiflow CRM · 100 customers per page</div></div></div><div class="crmWarn" id="crmWarn">Purchase data is temporarily unavailable. Label usage data is still shown normally.</div>
      <div class="scroll"><table>
        <thead><tr><th>#</th><th>Customer</th><th>Mobile</th><th>Labels Printed</th><th>Print Commands</th><th>Bills</th><th>Sales</th><th>Last Purchase</th><th>Last Activity</th></tr></thead>
        <tbody id="customers"></tbody>
      </table></div>
      <div class="pager"><div class="pageInfo" id="customerPageInfo"></div><div class="pageBtns"><button class="pageBtn" id="customerPrev" onclick="changeCustomerPage(-1)">Previous</button><button class="pageBtn" id="customerNext" onclick="changeCustomerPage(1)">Next</button></div></div>
    </div>

    <div class="tabBody" id="recentTab">
      <div class="tableHead"><div><h2>Recent Activity</h2><div class="note">Most recent printing and billing activity first</div></div></div>
      <div class="scroll"><table>
        <thead><tr><th>Date & Time</th><th>Customer</th><th>Mobile</th><th>Activity</th><th>Details</th><th>Printer Model</th></tr></thead>
        <tbody id="recent"></tbody>
      </table></div>
      <div class="pager"><div class="pageInfo" id="recentPageInfo"></div><div class="pageBtns"><button class="pageBtn" id="recentPrev" onclick="changeRecentPage(-1)">Previous</button><button class="pageBtn" id="recentNext" onclick="changeRecentPage(1)">Next</button></div></div>
    </div>

    <div class="tabBody" id="modelTab">
      <div class="tableHead"><div><h2>Printer Models</h2><div class="note">Bluetooth serial/address suffixes are merged into the base model name</div></div></div>
      <div class="scroll"><table>
        <thead><tr><th>#</th><th>Model</th><th>Unique Customers</th><th>Print Commands</th><th>Copies Printed</th><th>Last Used</th></tr></thead>
        <tbody id="models"></tbody>
      </table></div>
    </div>
  </section>
</main>
</div>

<div class="modalBack" id="modalBack" onclick="if(event.target===this)closeModal()">
  <div class="modal">
    <div class="modalHead"><h3 id="modalTitle">Customer Activity</h3><button class="close" onclick="closeModal()">×</button></div>
    <div class="modalBody" id="modalBody"></div>
  </div>
</div>

<script>
const money=n=>'₹'+Number(n||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});
const dt=v=>v?new Date(v).toLocaleString('en-IN'):'—';
const dateOnly=v=>v?new Date(v).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}):'—';
const esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
let customerPage=1,recentPage=1,customerPages=1,recentPages=1,activeTab='customerTab',searchTimer=null,currentRange='today';

function query(extra={}){
  const q=new URLSearchParams();
  ['customer','from','to','type'].forEach(id=>{const v=document.getElementById(id).value;if(v)q.set(id,v)});
  Object.entries(extra).forEach(([k,v])=>{if(v!==undefined&&v!==null&&v!=='')q.set(k,v)});
  return q;
}
function switchTab(id,btn){
  activeTab=id;
  document.querySelectorAll('.tabBody').forEach(x=>x.classList.toggle('active',x.id===id));
  document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===btn));
  if(id==='customerTab')loadCustomers();
  if(id==='recentTab')loadRecent();
  if(id==='modelTab')loadModels();
}
function applyFilter(){
  customerPage=1;recentPage=1;
  loadSummary();
  if(activeTab==='customerTab')loadCustomers();
  else if(activeTab==='recentTab')loadRecent();
  else loadModels();
}

function localDateValue(d){
  const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),day=String(d.getDate()).padStart(2,'0');
  return `${y}-${m}-${day}`;
}
function markRangeButton(btn){
  document.querySelectorAll('.rangeBtn').forEach(x=>x.classList.remove('active'));
  if(btn)btn.classList.add('active');
}
function setDateRange(kind,btn){
  currentRange=kind;markRangeButton(btn);
  const now=new Date();
  let start=new Date(now),end=new Date(now);

  if(kind==='today'){
    start=new Date(now);end=new Date(now);
  }else if(kind==='thisMonth'){
    start=new Date(now.getFullYear(),now.getMonth(),1);
    end=new Date(now);
  }else if(kind==='lastMonth'){
    start=new Date(now.getFullYear(),now.getMonth()-1,1);
    end=new Date(now.getFullYear(),now.getMonth(),0);
  }else if(kind==='allTime'){
    // Empty From/To means the backend returns complete lifetime data.
    from.value='';
    to.value='';
    applyFilter();
    return;
  }else if(kind==='custom'){
    from.focus();
    return;
  }

  from.value=localDateValue(start);
  to.value=localDateValue(end);
  applyFilter();
}
function setCustomRangeActive(){
  currentRange='custom';
  markRangeButton(document.getElementById('rangeCustom'));
}
async function loadSummary(){
  const r=await fetch('/api/usage/summary?'+query()),j=await r.json();if(!j.success)return;
  const t=j.totals||{};labels.textContent=(t.labelsPrinted||0).toLocaleString('en-IN');labelJobs.textContent=(t.labelPrintJobs||0).toLocaleString('en-IN');bills.textContent=(t.billsPrinted||0).toLocaleString('en-IN');sales.textContent=money(t.totalSales);users.textContent=(t.activeCustomers||0).toLocaleString('en-IN');
  const max=Math.max(1,...(j.daily||[]).map(x=>x.labels||0));bars.innerHTML=(j.daily||[]).length?(j.daily||[]).map(x=>`<div class="barWrap" title="${x._id.day}: ${(x.labels||0).toLocaleString('en-IN')} labels"><div class="bar" style="height:${Math.max(2,(x.labels||0)/max*100)}%"></div></div>`).join(''):'<div class="empty">No printing activity</div>';
  const maxS=Math.max(1,...(j.sizeWise||[]).map(x=>x.copies||0));sizes.innerHTML=(j.sizeWise||[]).length?(j.sizeWise||[]).map(x=>`<div class="sizeRow"><b>${x._id.w||0}×${x._id.h||0} mm</b><div class="track"><div class="fill" style="width:${(x.copies||0)/maxS*100}%"></div></div><b>${(x.copies||0).toLocaleString('en-IN')}</b></div>`).join(''):'<div class="empty">No label-size data</div>';
}
async function loadCustomers(){
  customers.innerHTML='<tr><td colspan="9" class="empty">Loading customers…</td></tr>';
  if(customer.value.trim())searchState.classList.add('show');
  const r=await fetch('/api/usage/customers?'+query({page:customerPage})),j=await r.json();if(!j.success)return;
  const p=j.pagination||{};customerPage=p.page||1;customerPages=p.pages||1;customerCount.textContent=p.total?`(${Number(p.total).toLocaleString('en-IN')})`:'';
  customers.innerHTML=(j.data||[]).length?(j.data||[]).map((x,i)=>`<tr>
    <td>${(customerPage-1)*100+i+1}</td>
    <td><button class="nameLink" onclick='openCustomer(${JSON.stringify(x._id.mobile||"")},${JSON.stringify(x._id.id||"")},${JSON.stringify(x.name||"Customer")})'>${esc(x.name||'Unknown')}</button><div class="email">${esc(x.email||'')}</div></td>
    <td><button class="mobileLink" onclick='openCustomer(${JSON.stringify(x._id.mobile||"")},${JSON.stringify(x._id.id||"")},${JSON.stringify(x.name||"Customer")})'>${esc(x._id.mobile||'—')}</button></td>
    <td class="num">${Number(x.labels||0).toLocaleString('en-IN')}</td><td class="num">${Number(x.printJobs||0).toLocaleString('en-IN')}</td><td class="num">${Number(x.bills||0).toLocaleString('en-IN')}</td><td class="num">${money(x.sales)}</td><td>${x.lastPurchaseDate?`<button class="purchaseLink" onclick='openPurchases(${JSON.stringify(x.normalizedMobile||x._id.mobile||"")},${JSON.stringify(x.name||"Customer")})'>${dateOnly(x.lastPurchaseDate)}</button><div class="purchaseMeta">${Number(x.crmOrderCount||0)} CRM order${Number(x.crmOrderCount||0)===1?'':'s'}</div>`:(j.purchaseSync==='ok'?`<span class="noPurchase">No purchase</span>`:`<span class="noPurchase" title="Check Posiflow CRM integration settings">CRM not connected</span>`) }</td><td>${dt(x.lastActivity)}</td>
  </tr>`).join(''):'<tr><td colspan="9" class="empty">No customers found</td></tr>';
  crmWarn.style.display=(j.purchaseSync==='unavailable'||j.purchaseSync==='not_configured')?'block':'none';
  customerPageInfo.textContent=`Page ${customerPage} of ${customerPages} · ${Number(p.total||0).toLocaleString('en-IN')} customers`;
  customerPrev.disabled=customerPage<=1;customerNext.disabled=customerPage>=customerPages;
  searchState.classList.remove('show');
}
function changeCustomerPage(d){const n=customerPage+d;if(n>=1&&n<=customerPages){customerPage=n;loadCustomers();document.getElementById('customerTab').scrollIntoView({behavior:'smooth',block:'start'})}}
async function loadRecent(){
  recent.innerHTML='<tr><td colspan="6" class="empty">Loading activity…</td></tr>';
  const r=await fetch('/api/usage/recent?'+query({page:recentPage})),j=await r.json();if(!j.success)return;
  const p=j.pagination||{};recentPage=p.page||1;recentPages=p.pages||1;
  recent.innerHTML=(j.data||[]).length?(j.data||[]).map(x=>`<tr><td>${dt(x.occurredAt)}</td><td><b>${esc(x.customerName||'Unknown')}</b></td><td>${esc(x.customerMobile||'—')}</td><td><span class="badge ${x.eventType==='LABEL_PRINT'?'label':'bill'}">${x.eventType==='LABEL_PRINT'?'LABEL PRINT':x.eventType==='BILL_PRINT'?'QUICK BILLING':'INVENTORY'}</span></td><td>${x.eventType==='LABEL_PRINT'?`${x.labelWidthMm||0}×${x.labelHeightMm||0} mm · ${Number(x.copies||0).toLocaleString('en-IN')} copies`:`${esc(x.billNo||'Bill')} · ${x.itemCount||0} items · ${money(x.billAmount)}`}</td><td>${esc(x.printerModel||'—')}</td></tr>`).join(''):'<tr><td colspan="6" class="empty">No recent activity found</td></tr>';
  recentPageInfo.textContent=`Page ${recentPage} of ${recentPages} · ${Number(p.total||0).toLocaleString('en-IN')} activities`;
  recentPrev.disabled=recentPage<=1;recentNext.disabled=recentPage>=recentPages;
}
function changeRecentPage(d){const n=recentPage+d;if(n>=1&&n<=recentPages){recentPage=n;loadRecent();document.getElementById('recentTab').scrollIntoView({behavior:'smooth',block:'start'})}}
async function loadModels(){
  models.innerHTML='<tr><td colspan="6" class="empty">Loading printer models…</td></tr>';
  const r=await fetch('/api/usage/models?'+query()),j=await r.json();if(!j.success)return;
  models.innerHTML=(j.data||[]).length?(j.data||[]).map((x,i)=>`<tr><td>${i+1}</td><td><span class="modelBadge">${esc(x.model)}</span></td><td class="num">${Number(x.uniqueCustomers||0).toLocaleString('en-IN')}</td><td class="num">${Number(x.commands||0).toLocaleString('en-IN')}</td><td class="num">${Number(x.copies||0).toLocaleString('en-IN')}</td><td>${dt(x.lastUsed)}</td></tr>`).join(''):'<tr><td colspan="6" class="empty">No printer model activity found</td></tr>';
}
async function openPurchases(mobile,name){
  modalTitle.textContent=`Purchase History · ${name||'Customer'}`; modalBody.innerHTML='<div class="empty">Loading Posiflow CRM orders…</div>'; modalBack.style.display='flex';
  const r=await fetch('/api/usage/purchase-history?mobile='+encodeURIComponent(mobile)); const j=await r.json().catch(()=>({success:false,message:'Unable to load purchase history'}));
  if(!r.ok||!j.success){modalBody.innerHTML=`<div class="empty">${esc(j.message||'Unable to load purchase history')}</div>`;return}
  const t=j.totals||{}; const rows=(j.data||[]).map(x=>`<tr><td>${dateOnly(x.date)}</td><td><b>${esc(x.orderId||'—')}</b></td><td>${(x.products||[]).map(p=>`${esc(p.name)}${p.qty?` × ${p.qty}`:''}`).join('<br>')||'—'}</td><td class="num">${money(x.amount)}</td><td>${esc(x.salesPerson||'—')}</td><td><span class="modelBadge">${esc(x.status||'—')}</span></td></tr>`).join('');
  modalBody.innerHTML=`<div class="miniMetrics"><div class="mini"><span>Last Purchase</span><b style="font-size:15px">${dateOnly(t.lastPurchaseDate)}</b></div><div class="mini"><span>Total Orders</span><b>${Number(t.orderCount||0).toLocaleString('en-IN')}</b></div><div class="mini"><span>Total Purchase</span><b>${money(t.totalPurchase)}</b></div><div class="mini"><span>Matched Mobile</span><b style="font-size:15px">${esc(j.mobile||mobile)}</b></div></div><div class="scroll"><table style="min-width:850px"><thead><tr><th>Order Date</th><th>Order ID</th><th>Products</th><th>Amount</th><th>Sales Person</th><th>Status</th></tr></thead><tbody>${rows||'<tr><td colspan="6" class="empty">No Posiflow orders found for this exact mobile number</td></tr>'}</tbody></table></div><div class="hint" style="margin-top:10px">Exact mobile-number match from Posiflow CRM. Cancelled and returned orders are excluded.</div>`;
}
function closeModal(){modalBack.style.display='none'}
async function openCustomer(mobile,id,name){
  modalTitle.textContent=`Recent Activity · ${name||'Customer'}`;modalBody.innerHTML='<div class="empty">Loading customer activity…</div>';modalBack.style.display='flex';
  const r=await fetch('/api/usage/customer-activity?'+query({mobile,id,page:1})),j=await r.json();
  if(!j.success){modalBody.innerHTML='<div class="empty">Unable to load customer activity</div>';return}
  const t=j.totals||{};
  const rows=(j.data||[]).map(x=>`<tr><td>${dt(x.occurredAt)}</td><td><span class="badge ${x.eventType==='LABEL_PRINT'?'label':'bill'}">${x.eventType==='LABEL_PRINT'?'LABEL PRINT':'QUICK BILLING'}</span></td><td>${x.eventType==='LABEL_PRINT'?`${x.labelWidthMm||0}×${x.labelHeightMm||0} mm · ${Number(x.copies||0).toLocaleString('en-IN')} copies`:`${esc(x.billNo||'Bill')} · ${money(x.billAmount)}`}</td><td>${esc(x.printerModel||'—')}</td></tr>`).join('');
  modalBody.innerHTML=`<div class="miniMetrics"><div class="mini"><span>Labels</span><b>${Number(t.labels||0).toLocaleString('en-IN')}</b></div><div class="mini"><span>Print Commands</span><b>${Number(t.printJobs||0).toLocaleString('en-IN')}</b></div><div class="mini"><span>Bills</span><b>${Number(t.bills||0).toLocaleString('en-IN')}</b></div><div class="mini"><span>Sales</span><b>${money(t.sales)}</b></div></div><div class="scroll"><table style="min-width:720px"><thead><tr><th>Date & Time</th><th>Activity</th><th>Details</th><th>Printer</th></tr></thead><tbody>${rows||'<tr><td colspan="4" class="empty">No activity in selected date range</td></tr>'}</tbody></table></div><div class="hint" style="margin-top:10px">Showing latest 100 records for the selected date filter.</div>`;
}
(function(){
  const now=new Date();
  from.value=localDateValue(now);
  to.value=localDateValue(now);

  from.addEventListener('change',setCustomRangeActive);
  to.addEventListener('change',setCustomRangeActive);

  customer.addEventListener('input',()=>{
    clearTimeout(searchTimer);
    searchTimer=setTimeout(()=>{
      customerPage=1;
      recentPage=1;
      loadSummary();
      if(activeTab==='customerTab')loadCustomers();
      else if(activeTab==='recentTab')loadRecent();
      else loadModels();
    },350);
  });

  customer.addEventListener('keydown',e=>{
    if(e.key==='Enter'){
      clearTimeout(searchTimer);
      customerPage=1;recentPage=1;applyFilter();
    }
  });

  loadSummary();
  loadCustomers();
})();
</script>
<script>
let targetPage=1,targetTotal=0,targetCurrent=[];
const tcSelected=new Set();
let tcFilterKey="";
let targetPendingPage=null;
function safeTargetText(v){return String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
async function targetAuthDialog(page){
 targetPendingPage=page;
 try {
  const r=await fetch('/api/targeting-auth/status',{credentials:'same-origin',cache:'no-store'});
  const state=await r.json();
  if(!state.configured){
   document.getElementById('targetStatus').textContent='Customer targeting requires secure admin setup. In Render → Environment, add ADMIN_PASSWORD (a strong new password) and SESSION_SECRET, then redeploy. Customer records remain protected.';
   document.getElementById('targetRows').innerHTML='<tr><td colspan="6">Administrator access is not configured on the server.</td></tr>';
   targetPendingPage=null;return;
  }
 }catch(e){document.getElementById('targetStatus').textContent='Unable to check admin configuration. Please retry.';targetPendingPage=null;return;} 
 document.getElementById('targetAuthError').style.display='none';
 const overlay=document.getElementById('targetAuthOverlay');overlay.style.display='flex';
 document.getElementById('targetAdminPassword').focus();
}
function closeTargetAuth(){
 document.getElementById('targetAuthOverlay').style.display='none';
 document.getElementById('targetAdminPassword').value='';
 targetPendingPage=null;
}
document.getElementById('targetAuthCancel').addEventListener('click',()=>{
 closeTargetAuth();document.getElementById('targetStatus').textContent='Admin verification is required to view customer targeting.';
});
document.getElementById('targetAuthForm').addEventListener('submit',async(e)=>{
 e.preventDefault();
 const btn=document.getElementById('targetAuthSubmit'),error=document.getElementById('targetAuthError');
 const password=document.getElementById('targetAdminPassword').value;
 if(!password)return;
 btn.disabled=true;btn.textContent='Verifying…';error.style.display='none';
 try{
  const response=await fetch('/api/verify-admin-password',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({password})});
  const result=await response.json();
  if(!response.ok||!result.success)throw Error(result.message||'Incorrect admin password. Please try again.');
  const page=targetPendingPage||1;
  closeTargetAuth();
  await loadTargetAudience(page);
 }catch(err){error.textContent=err.message||'Unable to verify. Please try again.';error.style.display='block';}
 finally{btn.disabled=false;btn.textContent='Verify & continue';}
});
async function loadTargetAudience(page){
 const status=document.getElementById('targetStatus');status.textContent='Loading matching customers…';
 const [width,height]=document.getElementById('targetSize').value.split('x');
 const p=new URLSearchParams({width,height,period:document.getElementById('targetPeriod').value,minPrints:document.getElementById('targetMinimum').value,page:String(page),from:document.getElementById('targetFrom').value,to:document.getElementById('targetTo').value});
 try{
  const r=await fetch('/api/targeting/audience?'+p.toString(),{credentials:'same-origin'});
  const j=await r.json();
  if(r.status===401){status.textContent='Admin verification required to view customer results.';targetAuthDialog(page);return;}
  if(!r.ok||!j.success)throw Error(j.message||'Unable to fetch customers');
  targetPage=j.page;targetTotal=j.total;targetCurrent=j.rows||[];
  const filterKey=[width,height,document.getElementById('targetPeriod').value,document.getElementById('targetMinimum').value,document.getElementById('targetFrom').value,document.getElementById('targetTo').value].join('|');
  if(tcFilterKey&&tcFilterKey!==filterKey)tcSelected.clear();tcFilterKey=filterKey;
  status.textContent=j.total.toLocaleString('en-IN')+' matching customers · page '+j.page+' of '+Math.max(1,Math.ceil(j.total/100))+' · '+Math.ceil(j.total/5000)+' batches of up to 5,000';
  document.getElementById('targetRows').innerHTML=targetCurrent.length?targetCurrent.map((x,i)=>'<tr><td><input type="checkbox" class="targetCheck" data-index="'+i+'" '+(tcSelected.has(x._id)?'checked':'')+' onchange="targetCountSelected()"></td><td>'+safeTargetText(x.name||x._id)+'</td><td>'+safeTargetText(x.mobile)+'</td><td>'+Number(x.copies||0).toLocaleString('en-IN')+'</td><td>'+Number(x.jobs||0).toLocaleString('en-IN')+'</td><td>'+safeTargetText(x.lastUsed?new Date(x.lastUsed).toLocaleDateString('en-IN'):'')+'</td></tr>').join(''):'<tr><td colspan="6">No matching customers</td></tr>';
  document.getElementById('targetSelectPage').checked=targetCurrent.length>0&&targetCurrent.every(x=>tcSelected.has(x._id));targetCountSelected(false);
 }catch(e){status.textContent=e.message;document.getElementById('targetRows').innerHTML='<tr><td colspan="6">Audience unavailable</td></tr>';}
}
function selectTargetPage(v){document.querySelectorAll('.targetCheck').forEach(c=>c.checked=v);targetCountSelected();}
function targetCountSelected(update=true){
 if(update)document.querySelectorAll('.targetCheck').forEach(c=>{const id=targetCurrent[Number(c.dataset.index)]?._id;if(id){if(c.checked)tcSelected.add(id);else tcSelected.delete(id);}});
 document.getElementById('targetSelected').textContent=tcSelected.size+' selected across pages ('+document.querySelectorAll('.targetCheck:checked').length+' on this page)';
}
function tcParams(){const [width,height]=document.getElementById('targetSize').value.split('x');return {width:Number(width),height:Number(height),period:document.getElementById('targetPeriod').value,minPrints:Number(document.getElementById('targetMinimum').value),from:document.getElementById('targetFrom').value,to:document.getElementById('targetTo').value};}
// Product search uses the live Shop database. Never accept a free-typed product ID.
let tcProductTimer,tcProductRequest=0;
const tcSearch=document.getElementById('tcProductSearch'),tcResults=document.getElementById('tcProductResults');
const tcHidden=document.getElementById('tcProduct'),tcVariant=document.getElementById('tcVariant');
function tcClearProduct(){tcHidden.value='';tcVariant.innerHTML='<option value="">Default product</option>';tcVariant.disabled=true;document.getElementById('tcProductPicked').textContent='Choose an active Shop product.';}
async function tcSearchProducts(){
 const seq=++tcProductRequest;
 tcResults.style.display='block';tcResults.textContent='Searching Shop products…';
 try{
  const r=await fetch('/api/targeting/products?q='+encodeURIComponent(tcSearch.value.trim()),{credentials:'same-origin'});
  const j=await r.json();if(seq!==tcProductRequest)return;
  if(!r.ok||!j.success)throw Error(j.message||'Product search failed');
  tcResults.replaceChildren();
  if(!j.products.length){tcResults.textContent='No active Shop products found.';return;}
  j.products.forEach(p=>{
   const option=document.createElement('button');option.type='button';option.setAttribute('role','option');
   option.style.cssText='display:block;width:100%;text-align:left;background:white;border:0;border-bottom:1px solid #eef2f6;padding:10px;cursor:pointer;color:#14233d';
   const title=document.createElement('strong');title.textContent=p.name;option.appendChild(title);
   const detail=document.createElement('div');detail.style.cssText='font-size:12px;color:#64748b;margin-top:3px';detail.textContent=[p.sku,p.category,'₹'+Number(p.price||0).toLocaleString('en-IN')].filter(Boolean).join(' · ');option.appendChild(detail);
   option.addEventListener('click',()=>{
    tcHidden.value=p.id;tcSearch.value=p.name+(p.sku?' ('+p.sku+')':'');
    document.getElementById('tcProductPicked').textContent='Selected: '+p.name+' · ₹'+Number(p.price||0).toLocaleString('en-IN');
    tcVariant.replaceChildren();const def=document.createElement('option');def.value='';def.textContent='Default product';tcVariant.appendChild(def);
    (p.variants||[]).forEach(v=>{const el=document.createElement('option');el.value=v.sku;el.textContent=v.name+' · '+v.sku+' · ₹'+Number(v.price||0).toLocaleString('en-IN');tcVariant.appendChild(el)});
    tcVariant.disabled=!(p.variants||[]).length;tcResults.style.display='none';tcSearch.setAttribute('aria-expanded','false');
   });tcResults.appendChild(option);
  });tcSearch.setAttribute('aria-expanded','true');
 }catch(e){if(seq===tcProductRequest)tcResults.textContent=e.message||'Unable to search products';}
}
tcSearch.addEventListener('input',()=>{tcClearProduct();clearTimeout(tcProductTimer);tcProductTimer=setTimeout(tcSearchProducts,300)});
tcSearch.addEventListener('focus',()=>{if(!tcHidden.value)tcSearchProducts()});
document.addEventListener('click',e=>{if(!tcSearch.contains(e.target)&&!tcResults.contains(e.target)){tcResults.style.display='none';tcSearch.setAttribute('aria-expanded','false')}});
document.getElementById('tcSave').addEventListener('click',async()=>{
 const status=document.getElementById('tcStatus'),btn=document.getElementById('tcSave');
 const mode=document.getElementById('tcMode').value;
 if(!targetTotal){status.textContent='Find customers first.';return;}
 if(!tcHidden.value){status.textContent='Select a Shop product from the search dropdown.';return;}
 if(mode==='manual'&&!tcSelected.size){status.textContent='Select customers using the table checkboxes first.';return;}
 const body={...tcParams(),mode,batch:Number(document.getElementById('tcBatch').value),channel:document.getElementById('tcChannel').value,title:document.getElementById('tcTitle').value,productId:document.getElementById('tcProduct').value,variantSku:document.getElementById('tcVariant').value,discountType:document.getElementById('tcDiscountType').value,discountValue:Number(document.getElementById('tcDiscount').value),identities:mode==='manual'?[...tcSelected]:[]};
 btn.disabled=true;status.textContent='Saving campaign draft…';
 try{const r=await fetch('/api/targeting/drafts',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const j=await r.json();if(!r.ok||!j.success)throw Error(j.message||'Save failed');status.textContent='Draft saved: '+j.count.toLocaleString('en-IN')+' customers. ID: '+j.id+'. No notifications sent and no discount activated.';tcLoadHistory();}
 catch(e){status.textContent='Unable to save: '+e.message;}
 finally{btn.disabled=false;}
});
async function tcReviewDraft(id){
 const box=document.getElementById('tcReview');box.style.display='block';box.textContent='Reviewing audience and device registration…';
 try{
  const r=await fetch('/api/targeting/drafts/'+encodeURIComponent(id)+'/review',{credentials:'same-origin'});
  const j=await r.json();if(!r.ok||!j.success)throw Error(j.message||'Review failed');const v=j.review;
  box.replaceChildren();const heading=document.createElement('strong');heading.textContent='Campaign review: '+v.title;box.appendChild(heading);
  const items=[['Saved audience',v.audienceCount.toLocaleString('en-IN')],['Account-ID candidates',v.accountIdCandidates.toLocaleString('en-IN')],['Accounts with registered devices',v.registeredDeviceAccounts.toLocaleString('en-IN')],['Accounts with device seen in last 90 days',(v.recentDeviceAccounts||0).toLocaleString('en-IN')],['Marketing consent verified',String(v.marketingConsentVerified||0)],['Unverified audience identities',v.unverifiedIdentities.toLocaleString('en-IN')],['Shop product',v.product?v.product.name:'Product missing'],['Promotion',v.discountValue+(v.discountType==='percent'?'%':' INR')],['Status','Draft — delivery and discount disabled']];
  items.forEach(([k,val])=>{const line=document.createElement('div');line.style.marginTop='7px';line.textContent=k+': '+val;box.appendChild(line)});
  const warning=document.createElement('div');warning.style.cssText='margin-top:14px;padding:12px;border:1px solid #fed7aa;background:#fff7ed;border-radius:8px;color:#9a3412';
  const warningTitle=document.createElement('strong');warningTitle.textContent='Activation blocked — outstanding checks';warning.appendChild(warningTitle);
  (v.blockers||[]).forEach(b=>{const line=document.createElement('div');line.style.marginTop='6px';line.textContent='• '+b;warning.appendChild(line)});box.appendChild(warning);
  const note=document.createElement('p');note.style.marginBottom='0';note.textContent='Review only. No push, banner or checkout discount is activated. Device registration alone does not prove marketing consent.';box.appendChild(note);
 }catch(e){box.textContent='Review unavailable: '+e.message;}
}
async function tcLoadHistory(){
 try{const r=await fetch('/api/targeting/drafts',{credentials:'same-origin'});if(!r.ok)return;const j=await r.json();const history=document.getElementById('tcHistory');history.replaceChildren();
 (j.drafts||[]).slice(0,10).forEach(d=>{const row=document.createElement('div');row.style.cssText='display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:7px 0;border-bottom:1px solid #e2e8f0';const name=document.createElement('span');name.textContent=d.title+' · '+d.channel+' · '+d.status+' · '+new Date(d.createdAt).toLocaleDateString();row.appendChild(name);const btn=document.createElement('button');btn.type='button';btn.textContent='Review audience';btn.style.cssText='padding:6px 10px;border:1px solid #cbd5e1;border-radius:6px;background:#fff;cursor:pointer';btn.addEventListener('click',()=>tcReviewDraft(d._id));row.appendChild(btn);history.appendChild(row)});
 }catch(e){document.getElementById('tcStatus').textContent='Could not load saved campaign history.';}
}
tcLoadHistory();
</script>
</body></html>