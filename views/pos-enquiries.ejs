<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>POS Enquiries · EasyLabel</title><style>body{font:14px system-ui;background:#f5f7fb;color:#182334;margin:0;padding:28px}h1{margin:0 0 8px}.wrap{max-width:1500px;margin:auto}.card{background:white;border:1px solid #e5eaf1;border-radius:16px;padding:20px;overflow:auto}a{color:#1261c8}table{width:100%;border-collapse:collapse;white-space:nowrap}th,td{padding:12px;text-align:left;border-bottom:1px solid #edf0f4}th{color:#65748b}select,button{padding:9px;border:1px solid #d8dee8;border-radius:8px;background:white}button{background:#ef3340;color:white;border:0;cursor:pointer}form{display:flex;gap:6px}</style></head><body><div class="wrap"><p><a href="/shop-management">← Shop Manager</a></p><h1>POS Purchase Enquiries</h1><p>Registered customer details and purchase requirements</p><div class="card"><p><a href="/api/pos-enquiries/admin">All</a> · <a href="?status=New">New</a> · <a href="?status=Contacted">Contacted</a> · <a href="?status=Converted">Converted</a> · <a href="?status=Closed">Closed</a></p><table><thead><tr><th>Received</th><th>Customer</th><th>Mobile</th><th>Email</th><th>Business</th><th>Outlets</th><th>Purchase</th><th>Discount</th><th>Status</th></tr></thead><tbody><% items.forEach(function(i){ %><tr><td><%= new Date(i.createdAt).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %></td><td><%= i.customerName || '—' %></td><td><%= i.customerPhone || '—' %></td><td><%= i.customerEmail || '—' %></td><td><%= i.businessType %></td><td><%= i.outlets %></td><td><%= i.purchaseTimeline %></td><td><%= i.discountInterest?'Yes':'No' %></td><td><form method="post" action="/api/pos-enquiries/admin/<%= i._id %>/status"><select name="status"><% ['New','Contacted','Converted','Closed'].forEach(function(s){ %><option value="<%=s%>" <%= i.status===s?'selected':'' %>><%=s%></option><% }) %></select><button>Save</button></form></td></tr><% }) %></tbody></table><% if(!items.length){ %><p>No enquiries yet.</p><% } %></div></div></body></html>