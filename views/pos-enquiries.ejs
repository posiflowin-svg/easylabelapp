<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Purchase Enquiries · EasyLabel</title><style>
*{box-sizing:border-box}body{font:14px system-ui,sans-serif;background:#f5f7fb;color:#182334;margin:0;padding:26px}.wrap{max-width:1500px;margin:auto}h1{margin:8px 0}p{color:#64748b}.card{background:white;border:1px solid #e5eaf1;border-radius:16px;padding:20px;overflow:auto}a{color:#1261c8}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0}.tabs a{padding:10px 16px;border-radius:9px;text-decoration:none;background:#fff;border:1px solid #e1e5eb;color:#334155}.tabs a.active{background:#ef3340;color:white;border-color:#ef3340}table{width:100%;border-collapse:collapse;white-space:nowrap}th,td{padding:12px;text-align:left;border-bottom:1px solid #edf0f4;vertical-align:top}th{color:#65748b}select,button{padding:9px;border:1px solid #d8dee8;border-radius:8px;background:white}button{background:#ef3340;color:white;border:0;cursor:pointer}form.inline{display:flex;gap:6px}small{color:#64748b}.top{display:flex;align-items:center;justify-content:space-between;gap:12px}.status{display:flex;gap:14px;flex-wrap:wrap;margin:12px 0 20px}.details{white-space:normal;min-width:240px;line-height:1.7}
</style></head><body><div class="wrap"><div class="top"><a href="/shop-management">← Shop Manager</a><form method="post" action="/api/pos-enquiries/admin/logout"><button type="submit" style="background:white;color:#334155;border:1px solid #ddd">Sign out</button></form></div><h1>Purchase Enquiries</h1><p>POS machines and Thermal Label Rolls — customer enquiries</p>
<div class="tabs"><% [['ALL','All Enquiries'],['POS','POS Billing Machine'],['THERMAL_LABEL','Thermal Labels']].forEach(function(t){ %><a class="<%=category===t[0]?'active':''%>" href="/api/pos-enquiries/admin?<%=new URLSearchParams({...(t[0]!=='ALL'?{category:t[0]}:{}),...(status?{status}:{} )}).toString()%>"><%=t[1]%></a><% }) %></div>
<div class="card"><div class="status"><% [['','All'],['New','New'],['Contacted','Contacted'],['Converted','Converted'],['Closed','Closed']].forEach(function(t){ %><a href="/api/pos-enquiries/admin?<%=new URLSearchParams({...(category!=='ALL'?{category}:{}),...(t[0]?{status:t[0]}:{})}).toString()%>" style="font-weight:<%=status===t[0]?'700':'400'%>"><%=t[1]%></a><% }) %></div>
<table><thead><tr><th>Received</th><th>Category</th><th>Customer</th><th>Identity</th><th>Mobile</th><th>Email</th><th>Requirements</th><th>Status</th></tr></thead><tbody><% items.forEach(function(i){ const isLabel=i.enquiryType==='THERMAL_LABEL'; %><tr><td><%=new Date(i.createdAt).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'})%></td><td><strong><%=isLabel?'Thermal Label':'POS Billing Machine'%></strong></td><td><%=i.customerName||'—'%></td><td><%=i.identityVerification==='Verified'?'Verified':'Unverified'%></td><td><%=i.customerPhone||'—'%></td><td><%=i.customerEmail||'—'%></td><td class="details"><% if(isLabel){ %><b>Monthly usage:</b> <%=i.monthlyLabelUsage||'—'%><br><b>Label size:</b> <%=i.labelSize||'—'%><br><b>Type:</b> <%=i.labelType||'—'%><br><b>Has printer:</b> <%=i.hasLabelPrinter===true?'Yes':i.hasLabelPrinter===false?'No':'—'%><% if(i.productName||i.sku){ %><br><b>Product:</b> <%=i.productName||'—'%> <%=i.sku?'('+i.sku+')':''%><% } %><% if(i.specialRequirements){ %><br><b>Notes:</b> <%=i.specialRequirements%><% } %><% } else { %><b>Business:</b> <%=i.businessType||'—'%><br><b>Outlets:</b> <%=i.outlets||'—'%><br><b>Purchase:</b> <%=i.purchaseTimeline||'—'%><br><b>Discount:</b> <%=i.discountInterest?'Yes':'No'%><% } %></td><td><form class="inline" method="post" action="/api/pos-enquiries/admin/<%=i._id%>/status"><input type="hidden" name="category" value="<%=category==='ALL'?'':category%>"><input type="hidden" name="filterStatus" value="<%=status%>"><select name="status"><% ['New','Contacted','Converted','Closed'].forEach(function(s){ %><option value="<%=s%>" <%=i.status===s?'selected':''%>><%=s%></option><% }) %></select><button>Save</button></form></td></tr><% }) %></tbody></table><% if(!items.length){ %><p>No enquiries found for this filter.</p><% } %></div></div></body></html>